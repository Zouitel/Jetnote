    <string name="account_sync_description">"
                                D\'Aktivéierung vun der Google Drive
                                Kontosynchronisatioun fir dës Applikatioun
                                erlaabt Iech, Är Applikatiounsdaten,
                                wéi Notizen an Astellungen, nahtlos
