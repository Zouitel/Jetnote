    <string name="shake">"Schlëddere fir ze mellen"</string>
    <string name="shake_description">"
                              Et ass eng praktesch Fonktioun, déi
                              de Benotzer erlaabt, e Feedback- oder
                              Fehlermeldeprozess einfach duerch
                              physesch Schlëddere vun hirem Android-Apparat
                              ze starten. Amplaz duerch verschidde Menüen
                              ze navigéieren, fir \'Feedback schécken\'
                              oder \'Feeler mellen\' ze fannen.
                            "</string>
    <string name="block_screenshot">"Screenshot blockéieren"</string>
    <string name="block_screenshot_description">"
                                D\'Screenshot-Blockéierung ass eng
                                Sécherheetsmesure, déi verhënnert, datt
                                Benotzer Screenshots vum Inhalt vun
                                Ärer App maachen. Et gëtt dacks benotzt,
                                fir sensibel Informatiounen ze schützen,
                                wéi Bankdaten, perséinlech Daten oder
                                urheberrechtlech geschützt Material.
                            "</string>
    <string name="lock_mode">"Spärrmodus"</string>
    <string name="lock_mode_description">"
                                Dës Fonktioun verbessert d\'Sécherheet
                                vun Ärer App, andeems se d\'Benotzer
                                opfuerdert, sech ze authentifizéieren,
                                éier se op den Inhalt zougräife kënnen.
                                Dëst gëtt typesch mat de integréierte
                                Sécherheetsfunktiounen vum Apparat
                                erreecht, wéi Fingerofdrockscanner,
                                PIN oder Muster-Entspärrung.
                            "</string>
