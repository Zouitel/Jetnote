    <string name="zen_mode">"Zen Modu"</string>
    <string name="zen_mode_description">"
                                Zen modu (tam ekran modu), bir uygulamanın
                                tüm ekranı kaplamasına olanak tanıyan
                                ve araç çubukları, menüler ile işletim
                                sisteminin görev çubuğu gibi tüm diğer
                                arayüz öğelerini gizleyen bir görüntü
                                ayarıdır.
                            "</string>
    <string name="shake">"Sallayarak Bildir"</string>
    <string name="shake_description">"
                              Kullanıcıların Android cihazlarını fiziksel
                              olarak sallayarak bir geri bildirim veya
                              hata bildirme sürecini başlatmalarına olanak
                              tanıyan kullanışlı bir özelliktir.
                              \'Geri Bildirim Gönder\' veya \'Hata Bildir\'
                              seçeneğini bulmak için birden fazla menüde
                              gezinmek yerine kolayca kullanabilirsiniz.
                            "</string>
    <string name="block_screenshot">"Ekran Görüntüsünü Engelle"</string>
    <string name="block_screenshot_description">"
                                Ekran görüntüsü engelleme, kullanıcıların
                                uygulamanızın içeriğinin ekran görüntüsünü
                                almasını önleyen bir güvenlik önlemidir.
                                Bankacılık bilgileri, kişisel veriler veya
                                telif hakkıyla korunan materyaller gibi
                                hassas bilgileri korumak için sıklıkla
                                kullanılır.
                            "</string>
    <string name="lock_mode">"Kilit Modu"</string>
    <string name="lock_mode_description">"
                                Bu özellik, kullanıcıların içeriğe
                                erişmeden önce kimlik doğrulaması
                                yapmasını zorunlu kılarak uygulamanın
                                güvenliğini artırır.
                                Bu genellikle parmak izi, PIN veya
                                desen kilidi gibi cihazın yerleşik
                                güvenlik özellikleri kullanılarak
                                gerçekleştirilir.
                            "</string>
    <string name="licenses">"Lisanslar"</string>
    <string name="licenses_description">"
                                    Bu lisanslar, ilgili yazarların dağıtım
                                    gerekliliklerine uymak ve yazılımın
                                    mimarisine ilişkin şeffaflık sağlamak
                                    amacıyla buraya dahil edilmiştir.
                                    "</string>
