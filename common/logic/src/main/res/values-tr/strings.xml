    <string name="account_sync">"Hesap Senkronizasyonu"</string>
    <string name="account_sync_description">"
                                Bu uygulama için Google Drive hesap
                                senkronizasyonunu etkinleştirmek,
                                notlar ve ayarlar gibi uygulama verilerinizi
                                sorunsuz şekilde yedeklemenizi ve
                                senkronize etmenizi sağlar,
                                böylece verileriniz güvende kalır.
        "</string>
    <string name="assistant_configuration">"Asistan Yapılandırması"</string>
    <string name="assistant_configuration_description">"
                                AI asistanı, bu uygulamada geniş bir görev
                                yelpazesinde size yardımcı olmak için
                                tasarlanmış, yapay zeka destekli bir
                                yazılım programıdır.
                                Bu asistanlar doğal dili anlayıp yanıtlar,
                                böylece görsel veya metin aracılığıyla
                                onlarla etkileşim kurabilirsiniz.
                            "</string>
    <string name="dark_mode">"Karanlık Mod"</string>
    <string name="dark_mode_description">"
                                Bu mod, Android uygulamanızın arayüzünün
                                arka plan rengini daha koyu renklerle
                                değiştiren sistem genelinde bir ayardır.
                                Göz yorgunluğunu azaltmak, erişilebilirliği
                                iyileştirmek, pil ömrünü uzatmak ve
                                kullanıcı deneyimini geliştirmek için
                                tasarlanmıştır.
                            "</string>
    <string name="sound_effect">"Ses Efekti"</string>
    <string name="sound_effect_description">"
                                Jetnote uygulaması bağlamında,
                                \'Ses Efekti\' özelliği, kullanıcılar
                                düğmeler ve diğer arayüz öğeleriyle
                                etkileşime girdiğinde sesli geri bildirim
                                sağlar. Bu, kullanıcı deneyimini daha
                                etkileşimli ve ilgi çekici hale getirmek
                                için mobil uygulama geliştirmede
                                yaygın bir uygulamadır.
                            "</string>
    <string name="layouts">"Düzenler"</string>
    <string name="layouts_description">"
                                Düzenler, Android uygulamalarınızda
                                içeriği organize etmek ve görüntülemek
                                için temel öneme sahiptir.
                                Ekrandaki arayüz öğelerinin yapısını
                                ve düzenlemesini tanımlarlar.
                            "</string>
