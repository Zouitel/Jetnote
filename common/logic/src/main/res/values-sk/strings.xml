    <string name="newest_sort">"najnovšie"</string>
    <string name="priority_sort">"priorita"</string>
    <string name="zen_mode">"Zen režim"</string>
    <string name="zen_mode_description">"
                                Zen režim (režim celej obrazovky) je
                                nastavenie displeja, ktoré umožňuje
                                aplikácii zabrať celú obrazovku, pričom
                                skryje všetky ostatné prvky rozhrania,
                                ako sú panely nástrojov, ponuky a panel
                                úloh operačného systému.
                            "</string>
    <string name="shake">"Zatraste pre nahlásenie"</string>
    <string name="shake_description">"
                              Je to praktická funkcia, ktorá umožňuje
                              používateľom spustiť proces spätnej väzby
                              alebo hlásenia chýb jednoduchým fyzickým
                              zatrasením zariadenia Android. Namiesto
                              prechádzania cez viaceré ponuky hľadajúc
                              \'Odoslať spätnú väzbu\' alebo
                              \'Nahlásiť chybu\'.
                            "</string>
    <string name="block_screenshot">"Blokovať snímku obrazovky"</string>
    <string name="block_screenshot_description">"
                                Blokovanie snímok obrazovky je
                                bezpečnostné opatrenie, ktoré bráni
                                používateľom zachytiť snímky obsahu
                                vašej aplikácie. Často sa používa na
                                ochranu citlivých informácií, ako sú
                                bankové údaje, osobné dáta alebo
                                materiál chránený autorskými právami.
                            "</string>
    <string name="lock_mode">"Režim uzamknutia"</string>
    <string name="lock_mode_description">"
                                Táto funkcia zvyšuje bezpečnosť aplikácie
                                tým, že vyžaduje overenie totožnosti
                                pred prístupom k obsahu. Dosahuje sa to
                                pomocou vstavaných bezpečnostných funkcií
                                zariadenia, ako sú odtlačok prsta, PIN
                                alebo vzor odomknutia.
                            "</string>
