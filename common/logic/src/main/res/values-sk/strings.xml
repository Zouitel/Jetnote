    <string name="account_sync">"Synchronizácia účtu"</string>
    <string name="account_sync_description">"
                                Povolenie synchronizácie účtu Google Drive
                                pre túto aplikáciu vám umožňuje bez problémov
                                zálohovať a synchronizovať údaje aplikácie,
                                ako sú poznámky a nastavenia,
                                čím sa zaistí bezpečnosť vašich dát.
        "</string>
    <string name="assistant_configuration">"Konfigurácia asistenta"</string>
    <string name="assistant_configuration_description">"
                                AI asistent je softvérový program
                                poháňaný umelou inteligenciou, navrhnutý
                                na pomoc s množstvom úloh v tejto aplikácii.
                                Títo asistenti rozumejú prirodzenému jazyku
                                a reagujú naň, čo vám umožňuje
                                komunikovať s nimi prostredníctvom
                                obrázka alebo textu.
                            "</string>
    <string name="dark_mode">"Tmavý režim"</string>
    <string name="dark_mode_description">"
                                Tento režim je celosystémové nastavenie,
                                ktoré prepína farebnú schému pozadia
                                rozhrania aplikácie Android na tmavšie farby.
                                Je navrhnutý na zníženie únavy očí,
                                zlepšenie dostupnosti, úsporu batérie
                                a zlepšenie používateľského zážitku.
                            "</string>
    <string name="sound_effect">"Zvukový efekt"</string>
    <string name="sound_effect_description">"
                                V kontexte aplikácie Jetnote funkcia
                                \'Zvukový efekt\' poskytuje používateľom
                                zvukovú spätnú väzbu pri interakcii
                                s tlačidlami a inými prvkami rozhrania.
                                Ide o bežnú prax pri vývoji mobilných
                                aplikácií, aby bol používateľský zážitok
                                interaktívnejší a pútavejší.
                            "</string>
    <string name="layouts">"Rozloženia"</string>
    <string name="layouts_description">"
                                Rozloženia sú základom pre organizovanie
                                a zobrazovanie obsahu v aplikáciách Android.
                                Definujú štruktúru a usporiadanie prvkov
                                rozhrania na obrazovke.
                            "</string>
    <string name="sort_notes">"Zoradiť poznámky"</string>
