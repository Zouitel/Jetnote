    <string name="newest_sort">"nieuwste"</string>
    <string name="priority_sort">"prioriteit"</string>
    <string name="zen_mode">"Zen-modus"</string>
    <string name="zen_mode_description">"
                                De zen-modus (volledig scherm) is een
                                weergave-instelling waarmee een applicatie
                                het volledige scherm kan innemen en alle
                                andere interface-elementen verbergt, zoals
                                werkbalken, menu\'s en de taakbalk van het
                                besturingssysteem.
                            "</string>
    <string name="shake">"Schudden om te melden"</string>
    <string name="shake_description">"
                              Een handige functie waarmee gebruikers
                              een feedback- of bugrapportageproces kunnen
                              starten door hun Android-apparaat fysiek te
                              schudden. In plaats van door meerdere menu\'s
                              te navigeren om \'Feedback verzenden\' of
                              \'Bug melden\' te vinden.
                            "</string>
    <string name="block_screenshot">"Schermafbeelding blokkeren"</string>
    <string name="block_screenshot_description">"
                                Het blokkeren van schermafbeeldingen is
                                een beveiligingsmaatregel die voorkomt dat
                                gebruikers schermafbeeldingen van de inhoud
                                van uw app maken. Dit wordt vaak gebruikt
                                om gevoelige informatie te beschermen,
                                zoals bankgegevens, persoonlijke gegevens
                                of auteursrechtelijk beschermd materiaal.
                            "</string>
    <string name="lock_mode">"Vergrendelmodus"</string>
    <string name="lock_mode_description">"
                                Deze functie verbetert de beveiliging van
                                uw app door gebruikers te verplichten zich
                                te verifiëren voordat ze toegang krijgen
                                tot de inhoud. Dit wordt doorgaans bereikt
                                met de ingebouwde beveiligingsfuncties van
                                het apparaat, zoals vingerafdruk, PIN of
                                patroonontgrendeling.
                            "</string>
    <string name="licenses">"Licenties"</string>
