    <string name="account_sync">"Accountsynchronisatie"</string>
    <string name="account_sync_description">"
                                Het inschakelen van Google Drive-synchronisatie
                                voor deze applicatie stelt u in staat uw
                                app-gegevens, zoals notities en instellingen,
                                naadloos te back-uppen en te synchroniseren,
                                zodat uw gegevens veilig zijn.
        "</string>
    <string name="assistant_configuration">"Assistentconfiguratie"</string>
    <string name="assistant_configuration_description">"
                                De AI-assistent is een softwareprogramma
                                aangedreven door kunstmatige intelligentie,
                                ontworpen om u te helpen met een breed scala
                                aan taken in deze applicatie.
                                Deze assistenten begrijpen en reageren op
                                natuurlijke taal, waardoor u via afbeelding
                                of tekst met hen kunt communiceren.
                            "</string>
    <string name="dark_mode">"Donkere modus"</string>
    <string name="dark_mode_description">"
                                Deze modus is een systeembrede instelling
                                die het achtergrondkleurenschema van uw
                                Android-app-interface naar donkerdere kleuren
                                verschuift. Het is ontworpen om oogvermoeidheid
                                te verminderen, toegankelijkheid te verbeteren,
                                batterij te besparen en de gebruikerservaring
                                te verbeteren.
                            "</string>
    <string name="sound_effect">"Geluidseffect"</string>
    <string name="sound_effect_description">"
                                In de context van de Jetnote-applicatie
                                biedt de functie \'Geluidseffect\' auditieve
                                feedback aan gebruikers wanneer zij interactie
                                hebben met knoppen en andere UI-elementen.
                                Dit is een gangbare praktijk in de ontwikkeling
                                van mobiele apps om de gebruikerservaring
                                interactiever en boeiender te maken.
                            "</string>
    <string name="layouts">"Indelingen"</string>
    <string name="layouts_description">"
                                Indelingen zijn fundamenteel voor het
                                organiseren en weergeven van inhoud in uw
                                Android-applicaties. Ze definiëren de
                                structuur en rangschikking van UI-elementen
                                op het scherm.
                            "</string>
    <string name="sort_notes">"Notities sorteren"</string>
    <string name="default_sort">"standaard"</string>
    <string name="name_sort">"naam"</string>
