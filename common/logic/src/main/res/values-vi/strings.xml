    <string name="account_sync">"Đồng bộ tài khoản"</string>
    <string name="account_sync_description">"
                                Bật đồng bộ tài khoản Google Drive cho
                                ứng dụng này giúp bạn dễ dàng sao lưu
                                và đồng bộ dữ liệu ứng dụng, chẳng hạn
                                như ghi chú và cài đặt, đảm bảo dữ liệu
                                của bạn được an toàn.
        "</string>
    <string name="assistant_configuration">"Cấu hình trợ lý"</string>
    <string name="assistant_configuration_description">"
                                Trợ lý AI là chương trình phần mềm được
                                hỗ trợ bởi trí tuệ nhân tạo, được thiết
                                kế để giúp bạn thực hiện nhiều tác vụ
                                trong ứng dụng này. Các trợ lý này hiểu
                                và phản hồi ngôn ngữ tự nhiên, cho phép
                                bạn tương tác với chúng qua hình ảnh
                                hoặc văn bản.
                            "</string>
    <string name="dark_mode">"Chế độ tối"</string>
    <string name="dark_mode_description">"
                                Chế độ này là cài đặt toàn hệ thống
                                chuyển màu nền giao diện ứng dụng Android
                                sang màu tối hơn. Được thiết kế để giảm
                                mỏi mắt, cải thiện khả năng truy cập,
                                tiết kiệm pin và nâng cao trải nghiệm
                                người dùng.
                            "</string>
    <string name="sound_effect">"Hiệu ứng âm thanh"</string>
    <string name="sound_effect_description">"
                                Trong bối cảnh ứng dụng Jetnote, tính
                                năng hiệu ứng âm thanh cung cấp phản hồi
                                âm thanh cho người dùng khi họ tương tác
                                với các nút và phần tử giao diện khác.
                                Đây là thực hành phổ biến trong phát
                                triển ứng dụng di động để làm cho trải
                                nghiệm người dùng trở nên tương tác và
                                hấp dẫn hơn.
                            "</string>
    <string name="layouts">"Bố cục"</string>
    <string name="layouts_description">"
                                Bố cục là nền tảng để tổ chức và hiển
                                thị nội dung trong các ứng dụng Android
                                của bạn. Chúng xác định cấu trúc và sắp
                                xếp các phần tử giao diện trên màn hình.
                            "</string>
    <string name="sort_notes">"Sắp xếp ghi chú"</string>
    <string name="default_sort">"mặc định"</string>
    <string name="name_sort">"tên"</string>
    <string name="oldest_sort">"cũ nhất"</string>
    <string name="newest_sort">"mới nhất"</string>
