    <string name="zen_mode">"Chế độ Zen"</string>
    <string name="zen_mode_description">"
                                Chế độ Zen (chế độ toàn màn hình) là
                                cài đặt hiển thị cho phép ứng dụng chiếm
                                toàn bộ màn hình, ẩn tất cả các phần tử
                                giao diện khác như thanh công cụ, menu
                                và thanh tác vụ của hệ điều hành.
                            "</string>
    <string name="shake">"Lắc để báo cáo"</string>
    <string name="shake_description">"
                              Đây là tính năng tiện lợi cho phép người
                              dùng bắt đầu quy trình phản hồi hoặc báo
                              cáo lỗi chỉ bằng cách lắc vật lý thiết
                              bị Android của họ, thay vì điều hướng qua
                              nhiều menu.
                            "</string>
    <string name="block_screenshot">"Chặn chụp màn hình"</string>
    <string name="block_screenshot_description">"
                                Chặn chụp màn hình là biện pháp bảo
                                mật ngăn người dùng chụp màn hình nội
                                dung ứng dụng của bạn. Thường được dùng
                                để bảo vệ thông tin nhạy cảm như thông
                                tin ngân hàng, dữ liệu cá nhân hoặc
                                tài liệu có bản quyền.
                            "</string>
    <string name="lock_mode">"Chế độ khóa"</string>
    <string name="lock_mode_description">"
                                Tính năng này tăng cường bảo mật ứng
                                dụng bằng cách yêu cầu người dùng xác
                                thực trước khi truy cập nội dung. Điều
                                này thường đạt được bằng cách sử dụng
                                các tính năng bảo mật tích hợp của thiết
                                bị, chẳng hạn như vân tay, mã PIN hoặc
                                mở khóa bằng hình vẽ.
                            "</string>
    <string name="licenses">"Giấy phép"</string>
    <string name="licenses_description">"
                                    Các giấy phép này được đưa vào đây
                                    để tuân thủ các yêu cầu phân phối
                                    của các tác giả tương ứng và cung
                                    cấp sự minh bạch về kiến trúc của
                                    phần mềm.
                                    "</string>
