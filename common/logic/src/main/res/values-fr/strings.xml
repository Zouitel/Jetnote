    <string name="headers">En-têtes</string>
    <string name="headers_description">
                            Ce sont des paires clé-valeur (clé : valeur)
                            ajoutées au bloc d\'en-tête de la requête.
                            Elles sont généralement utilisées pour
                            l\'authentification (comme les clés API ou les
                            jetons), la spécification du type de contenu,
                            ou le passage de métadonnées sur la requête.
                        </string>
    <string name="bodies">Corps</string>
    <string name="bodies_description">
                            Il s\'agit de la charge utile de données
                            (structure JSON clé : valeur) envoyée dans
                            la requête. C\'est le principal moyen d\'envoyer
                            des entrées au modèle IA. Ces personnalisations
                            sont généralement utilisées pour ajouter des
                            spécifications concrètes.
                        </string>
