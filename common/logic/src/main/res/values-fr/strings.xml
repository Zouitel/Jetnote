    <string name="account_sync">"Synchronisation du compte"</string>
    <string name="account_sync_description">"
                                L\'activation de la synchronisation du compte
                                Google Drive pour cette application vous
                                permet de sauvegarder et synchroniser
                                facilement les données de l\'application,
                                telles que les notes et les paramètres,
                                garantissant ainsi la sécurité de vos données.
        "</string>
    <string name="assistant_configuration">"Configuration de l\'assistant"</string>
    <string name="assistant_configuration_description">"
                                L\'assistant IA est un programme logiciel
                                alimenté par l\'intelligence artificielle,
                                conçu pour vous aider dans un large éventail
                                de tâches dans cette application.
                                Ces assistants comprennent le langage naturel
                                et y répondent, vous permettant d\'interagir
                                avec eux via des images ou du texte.
                            "</string>
    <string name="dark_mode">"Mode sombre"</string>
    <string name="dark_mode_description">"
                                Ce mode est un paramètre système qui
                                change le schéma de couleurs de fond de
                                l\'interface de votre application Android
                                vers des couleurs plus sombres. Il est
                                conçu pour réduire la fatigue oculaire,
                                améliorer l\'accessibilité, économiser la
                                batterie et améliorer l\'expérience utilisateur.
                            "</string>
    <string name="sound_effect">"Effet sonore"</string>
    <string name="sound_effect_description">"
                                Dans le contexte de l\'application Jetnote,
                                la fonctionnalité Effet sonore fournit
                                un retour auditif aux utilisateurs lorsqu\'ils
                                interagissent avec les boutons et autres
                                éléments de l\'interface. C\'est une pratique
                                courante dans le développement d\'applications
                                mobiles pour rendre l\'expérience utilisateur
                                plus interactive et engageante.
                            "</string>
    <string name="layouts">"Mises en page"</string>
    <string name="layouts_description">"
                                Les mises en page sont fondamentales pour
                                organiser et afficher le contenu dans vos
                                applications Android. Elles définissent la
                                structure et l\'agencement des éléments de
                                l\'interface sur l\'écran.
                            "</string>
    <string name="sort_notes">"Trier les notes"</string>
    <string name="default_sort">"par défaut"</string>
    <string name="name_sort">"nom"</string>
    <string name="oldest_sort">"plus ancien"</string>
    <string name="newest_sort">"plus récent"</string>
    <string name="priority_sort">"priorité"</string>
    <string name="zen_mode">"Mode Zen"</string>
    <string name="zen_mode_description">"
                                Le mode Zen (plein écran) est un paramètre
                                d\'affichage qui permet à une application
                                d\'occuper tout l\'écran, masquant tous les
                                autres éléments de l\'interface tels que
                                les barres d\'outils, les menus et la barre
                                des tâches du système d\'exploitation.
                            "</string>
    <string name="shake">"Secouer pour signaler"</string>
    <string name="shake_description">"
                              C\'est une fonctionnalité pratique qui permet
                              aux utilisateurs de démarrer un processus de
                              retour d\'information ou de signalement de bug
                              en secouant simplement leur appareil Android,
                              sans avoir à naviguer dans plusieurs menus.
                            "</string>
    <string name="block_screenshot">"Bloquer les captures d\'écran"</string>
    <string name="block_screenshot_description">"
                                Le blocage des captures d\'écran est une
                                mesure de sécurité qui empêche les
                                utilisateurs de capturer le contenu de
                                votre application. Cela est souvent utilisé
                                pour protéger des informations sensibles,
                                telles que les coordonnées bancaires, les
                                données personnelles ou le matériel protégé
                                par des droits d\'auteur.
                            "</string>
    <string name="lock_mode">"Mode verrouillage"</string>
    <string name="lock_mode_description">"
                                Cette fonctionnalité renforce la sécurité
                                de votre application en demandant aux
                                utilisateurs de s\'authentifier avant
                                d\'accéder à son contenu. Cela est
                                généralement réalisé à l\'aide des
                                fonctionnalités de sécurité intégrées
                                de l\'appareil, telles que l\'empreinte
                                digitale, le code PIN ou le schéma de
                                déverrouillage.
                            "</string>
    <string name="licenses">"Licences"</string>
    <string name="licenses_description">"
                                    Ces licences sont incluses ici pour
                                    se conformer aux exigences de distribution
                                    des auteurs respectifs et pour fournir
                                    de la transparence concernant l\'architecture
                                    du logiciel.
                                    "</string>
