    <string name="shake">"Ċaqlaq biex Tirrapporta"</string>
    <string name="shake_description">"
                              Hija karatteristika konvenjenti li
                              tippermetti lill-utenti jibdew proċess
                              ta\' feedback jew rappurtar ta\' bug
                              sempliċement billi jċaqalqu fiżikament
                              l-apparat Android tagħhom. Minflok
                              tinnnaviga minn menus multipli biex
                              issib \'Ibgħat Feedback\' jew
                              \'Irrapporta Bug\'.
                            "</string>
    <string name="block_screenshot">"Imblokka Screenshot"</string>
    <string name="block_screenshot_description">"
                                L-imblukkar tal-iskrinshot huwa miżura
                                ta\' sigurtà li tipprevjeni lill-utenti
                                milli jaqbdu screenshots tal-kontenut
                                tal-app tiegħek. Spiss jintuża biex
                                jipproteġi informazzjoni sensittiva,
                                bħal dettalji bankarji, dejta personali
                                jew materjal protett bid-drittijiet
                                tal-awtur.
                            "</string>
    <string name="lock_mode">"Modalità ta\' Blokkatura"</string>
    <string name="lock_mode_description">"
                                Din il-karatteristika ttejjeb is-sigurtà
                                tal-app tiegħek billi teħtieġ
                                lill-utenti jawtentikaw qabel ma
                                jaċċessaw il-kontenut. Dan tipikament
                                jinkiseb billi jintuża l-karatteristiċi
                                tas-sigurtà inkorporati tal-apparat,
                                bħall-fingerprint, PIN jew maqfal
                                bil-mudell.
                            "</string>
