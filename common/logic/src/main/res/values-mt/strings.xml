    <string name="assistant_configuration">"Konfigurazzjoni tal-Assistent"</string>
    <string name="assistant_configuration_description">"
                                L-assistent AI huwa programm tas-softwer
                                imħaddem mill-intelliġenza artifiċjali,
                                mfassal biex jgħinek f\'firxa wiesgħa
                                ta\' kompiti f\'din l-applikazzjoni.
                                Dawn l-assistenti jifhmu u jwieġbu
                                bil-lingwaġġ naturali, li jippermettik
                                tinteraġixxi magħhom permezz ta\'
                                immaġni jew test.
                            "</string>
    <string name="dark_mode">"Modalità Skura"</string>
    <string name="dark_mode_description">"
                                Din il-modalità hija setting tas-sistema
                                kollha li tibdel l-iskema tal-isfond
                                tal-UI tal-app Android tiegħek
                                għal kuluri aktar skuri.
                                Hija mfassla biex tnaqqas it-taħbit
                                tal-għajnejn, ttejjeb l-aċċessibbiltà,
                                tiffranka l-batterija u ttejjeb
                                l-esperjenza tal-utent.
                            "</string>
    <string name="sound_effect">"Effett ta\' Ħoss"</string>
    <string name="sound_effect_description">"
                                Fil-kuntest tal-applikazzjoni Jetnote,
                                il-karatteristika \'Effett ta\' Ħoss\'
                                tipprovdi feedback awditorju lill-utenti
                                meta jinteraġixxu ma\' buttuni u
                                elementi oħra tal-UI.
                                Din hija prattika komuni fl-iżvilupp
                                ta\' apps mobbli biex l-esperjenza
                                tal-utent tkun aktar interattiva u
                                attraenti.
                            "</string>
    <string name="layouts">"Tqassimiet"</string>
    <string name="layouts_description">"
                                It-tqassimiet huma fundamentali biex
                                torganizza u turi l-kontenut
                                fl-applikazzjonijiet Android tiegħek.
                                Huma jiddefinixxu l-istruttura u
                                l-arranġament tal-elementi tal-UI
                                fuq l-iskrin.
                            "</string>
