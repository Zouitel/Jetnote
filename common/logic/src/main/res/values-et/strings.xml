    <string name="account_sync">"Konto sünkroonimine"</string>
    <string name="account_sync_description">"
                                Google Drive\'i konto sünkroonimise
                                lubamine selles rakenduses võimaldab
                                teil rakenduse andmeid, nagu märkmed
                                ja seaded, sujuvalt varundada ja
                                sünkroonida, tagades andmete turvalisuse.
        "</string>
    <string name="assistant_configuration">"Assistendi seadistamine"</string>
    <string name="assistant_configuration_description">"
                                AI assistent on tehisintellektil põhinev
                                tarkvaraprogramm, mis on loodud aitama
                                teid selles rakenduses mitmesuguste
                                ülesannetega. Need assistendid mõistavad
                                ja vastavad loomulikus keeles, võimaldades
                                teil nendega suhelda pildi või teksti kaudu.
                            "</string>
    <string name="dark_mode">"Tume režiim"</string>
    <string name="dark_mode_description">"
                                See režiim on süsteemiülene seade, mis
                                lülitab teie Androidi rakenduse kasutajaliidese
                                taustavärvid tumedamateks.
                                See on loodud silmade väsimuse vähendamiseks,
                                juurdepääsetavuse parandamiseks,
                                aku säästmiseks ja kasutajakogemuse
                                parandamiseks.
                            "</string>
    <string name="sound_effect">"Heliefekt"</string>
    <string name="sound_effect_description">"
                                Jetnote\'i rakenduse kontekstis pakub
                                \'Heliefekti\' funktsioon kasutajatele
                                heli tagasisidet, kui nad suhtlevad
                                nuppude ja muude kasutajaliidese elementidega.
                                See on mobiilirakenduste arenduses tavaline
                                tava, mis muudab kasutajakogemuse
                                interaktiivsemaks ja kaasahaaravamaks.
                            "</string>
    <string name="layouts">"Paigutused"</string>
    <string name="layouts_description">"
                                Paigutused on Androidi rakenduste sisu
                                korraldamisel ja kuvamisel põhimõttelise
                                tähtsusega. Need määravad ekraanil
                                kasutajaliidese elementide struktuuri
                                ja paigutuse.
                            "</string>
