    <string name="zen_mode">"Zen-režiim"</string>
    <string name="zen_mode_description">"
                                Zen-režiim (täisekraanirežiim) on
                                kuvarisseade, mis võimaldab rakendusel
                                täita kogu ekraani, peites kõik muud
                                liideseelemendid, nagu tööriistaribad,
                                menüüd ja operatsioonisüsteemi tegumiriba.
                            "</string>
    <string name="shake">"Raputa, et teavitada"</string>
    <string name="shake_description">"
                              See on mugav funktsioon, mis võimaldab
                              kasutajatel käivitada tagasiside või
                              veateate protsess lihtsalt Androidi seadet
                              füüsiliselt raputades. Selle asemel, et
                              navigeerida läbi mitme menüü, et leida
                              \'Saada tagasisidet\' või \'Teata veast\'.
                            "</string>
    <string name="block_screenshot">"Blokeeri ekraanipilt"</string>
    <string name="block_screenshot_description">"
                                Ekraanipiltide blokeerimine on
                                turvameede, mis takistab kasutajatel
                                rakenduse sisu ekraanipilte teha.
                                Seda kasutatakse sageli tundliku teabe,
                                nagu pangaandmed, isikuandmed või
                                autoriõigusega kaitstud materjal,
                                kaitsmiseks.
                            "</string>
    <string name="lock_mode">"Lukustusrežiim"</string>
    <string name="lock_mode_description">"
                                See funktsioon tugevdab rakenduse
                                turvalisust, nõudes kasutajatelt
                                enne sisu juurdepääsu autentimist.
                                Seda saavutatakse tavaliselt seadme
                                sisseehitatud turvafunktsioonide abil,
                                nagu sõrmejälg, PIN-kood või muster.
                            "</string>
