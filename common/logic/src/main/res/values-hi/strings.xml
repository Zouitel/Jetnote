    <string name="account_sync">"खाता सिंक"</string>
    <string name="account_sync_description">"
                                इस ऐप के लिए Google Drive खाता सिंक
                                सक्षम करने से आप अपने ऐप डेटा,
                                जैसे नोट्स और सेटिंग्स, का आसानी से
                                बैकअप और सिंक कर सकते हैं,
                                जिससे आपका डेटा सुरक्षित रहता है।
        "</string>
    <string name="assistant_configuration">"सहायक कॉन्फ़िगरेशन"</string>
    <string name="assistant_configuration_description">"
                                AI सहायक एक सॉफ़्टवेयर प्रोग्राम है जो
                                कृत्रिम बुद्धिमत्ता द्वारा संचालित है
                                और इस ऐप में आपके विभिन्न कार्यों में
                                मदद करने के लिए बनाया गया है।
                                ये सहायक प्राकृतिक भाषा को समझते और
                                उत्तर देते हैं, जिससे आप छवि या
                                टेक्स्ट के माध्यम से उनसे बातचीत
                                कर सकते हैं।
                            "</string>
    <string name="dark_mode">"डार्क मोड"</string>
    <string name="dark_mode_description">"
                                यह मोड एक सिस्टम-व्यापी सेटिंग है जो
                                आपके Android ऐप की UI की पृष्ठभूमि
                                योजना को गहरे रंगों में बदल देती है।
                                यह आँखों की थकान कम करने,
                                पहुँच में सुधार करने, बैटरी बचाने
                                और उपयोगकर्ता अनुभव बेहतर बनाने
                                के लिए डिज़ाइन की गई है।
                            "</string>
    <string name="sound_effect">"ध्वनि प्रभाव"</string>
    <string name="sound_effect_description">"
                                Jetnote ऐप में, \'ध्वनि प्रभाव\' सुविधा
                                उपयोगकर्ताओं को बटन और अन्य UI तत्वों
                                के साथ इंटरैक्ट करने पर श्रवण फ़ीडबैक
                                प्रदान करती है।
                                यह मोबाइल ऐप विकास में एक आम प्रचलन है
                                जो उपयोगकर्ता अनुभव को अधिक
                                इंटरैक्टिव और आकर्षक बनाता है।
                            "</string>
    <string name="layouts">"लेआउट"</string>
    <string name="layouts_description">"
                                लेआउट आपके Android ऐप्स में सामग्री
                                को व्यवस्थित और प्रदर्शित करने के लिए
                                मौलिक हैं।
                                वे स्क्रीन पर UI तत्वों की संरचना और
                                व्यवस्था को परिभाषित करते हैं।
                            "</string>
    <string name="sort_notes">"नोट्स क्रमबद्ध करें"</string>
    <string name="default_sort">"डिफ़ॉल्ट"</string>
    <string name="name_sort">"नाम"</string>
