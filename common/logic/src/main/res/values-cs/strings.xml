    <string name="account_sync">"Synchronizace účtu"</string>
    <string name="account_sync_description">"
                                Povolení synchronizace účtu Google Drive
                                pro tuto aplikaci umožňuje bezproblémově
                                zálohovat a synchronizovat data aplikace,
                                jako jsou poznámky a nastavení, a zajistit
                                tak bezpečnost vašich dat.
        "</string>
    <string name="assistant_configuration">"Konfigurace asistenta"</string>
    <string name="assistant_configuration_description">"
                                Asistent AI je softwarový program poháněný
                                umělou inteligencí, navržený k pomoci
                                s různými úkoly v této aplikaci.
                                Tito asistenti rozumí přirozenému jazyku
                                a odpovídají na něj, takže s nimi můžete
                                komunikovat prostřednictvím obrázku nebo textu.
                            "</string>
    <string name="dark_mode">"Tmavý režim"</string>
    <string name="dark_mode_description">"
                                Tento režim je celosystémové nastavení,
                                které přepíná schéma pozadí uživatelského
                                rozhraní vaší Android aplikace na tmavší
                                barvy. Je navržen ke snížení namáhání
                                očí, zlepšení přístupnosti, úspoře baterie
                                a zlepšení uživatelského prostředí.
                            "</string>
    <string name="sound_effect">"Zvukový efekt"</string>
    <string name="sound_effect_description">"
                                V kontextu aplikace Jetnote funkce
                                \'Zvukový efekt\' poskytuje zvukovou zpětnou
                                vazbu uživatelům při interakci s tlačítky
                                a dalšími prvky rozhraní. Jde o běžnou
                                praxi ve vývoji mobilních aplikací pro
                                interaktivnější a poutavější uživatelský zážitek.
                            "</string>
    <string name="layouts">"Rozvržení"</string>
    <string name="layouts_description">"
                                Rozvržení jsou základem pro organizaci
                                a zobrazení obsahu ve vašich Android
                                aplikacích. Definují strukturu a uspořádání
                                prvků rozhraní na obrazovce.
                            "</string>
