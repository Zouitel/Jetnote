    <string name="zen_mode">"Režim Zen"</string>
    <string name="zen_mode_description">"
                                Režim Zen (celá obrazovka) je nastavení
                                zobrazení, které umožňuje aplikaci zabrat
                                celou obrazovku a skrýt všechny ostatní
                                prvky rozhraní, jako jsou panely nástrojů,
                                nabídky a hlavní panel operačního systému.
                            "</string>
    <string name="shake">"Zatřesením nahlásit"</string>
    <string name="shake_description">"
                              Pohodlná funkce, která umožňuje uživatelům
                              zahájit proces zpětné vazby nebo hlášení chyb
                              pouhým fyzickým zatřesením jejich Android
                              zařízením. Místo procházení několika nabídkami
                              pro nalezení \'Odeslat zpětnou vazbu\' nebo
                              \'Nahlásit chybu\'.
                            "</string>
    <string name="block_screenshot">"Blokovat snímek obrazovky"</string>
    <string name="block_screenshot_description">"
                                Blokování snímků obrazovky je bezpečnostní
                                opatření, které brání uživatelům pořizovat
                                snímky obsahu vaší aplikace. Často se
                                používá k ochraně citlivých informací,
                                jako jsou bankovní údaje, osobní data nebo
                                materiál chráněný autorskými právy.
                            "</string>
    <string name="lock_mode">"Režim zámku"</string>
    <string name="lock_mode_description">"
                                Tato funkce zvyšuje bezpečnost vaší
                                aplikace tím, že vyžaduje ověření uživatele
                                před přístupem k obsahu. Obvykle se
                                dosahuje pomocí vestavěných bezpečnostních
                                funkcí zařízení, jako je otisk prstu,
                                PIN nebo vzorové odemčení.
                            "</string>
    <string name="licenses">"Licence"</string>
    <string name="licenses_description">"
