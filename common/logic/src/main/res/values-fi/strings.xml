    <string name="zen_mode">"Zen-tila"</string>
    <string name="zen_mode_description">"
                                Zen-tila (koko näyttö) on näyttöasetus,
                                joka antaa sovelluksen täyttää koko
                                näytön, piilottaen kaikki muut
                                käyttöliittymäelementit, kuten
                                työkalupalkit, valikot ja
                                käyttöjärjestelmän tehtäväpalkin.
                            "</string>
    <string name="shake">"Ravista ilmoittaaksesi"</string>
    <string name="shake_description">"
                              Tämä on kätevä ominaisuus, jonka avulla
                              käyttäjät voivat käynnistää palautteen tai
                              virheraportoinnin prosessin yksinkertaisesti
                              ravistamalla Android-laitettaan fyysisesti.
                              Sen sijaan että navigoisit useiden valikoiden
                              läpi löytääksesi \'Lähetä palautetta\'
                              tai \'Ilmoita virheestä\'.
                            "</string>
    <string name="block_screenshot">"Estä kuvakaappaus"</string>
    <string name="block_screenshot_description">"
                                Kuvakaappausten esto on turvatoimenpide,
                                joka estää käyttäjiä ottamasta
                                kuvakaappauksia sovelluksen sisällöstä.
                                Sitä käytetään usein arkaluonteisten
                                tietojen, kuten pankkitietojen,
                                henkilötietojen tai tekijänoikeudella
                                suojatun materiaalin, suojaamiseen.
                            "</string>
    <string name="lock_mode">"Lukitustila"</string>
    <string name="lock_mode_description">"
                                Tämä ominaisuus parantaa sovelluksen
                                turvallisuutta edellyttämällä käyttäjiltä
                                todentamista ennen sisällön käyttöä.
                                Tämä toteutetaan tyypillisesti laitteen
                                sisäänrakennetuilla suojausominaisuuksilla,
                                kuten sormenjäljellä, PIN-koodilla tai
                                kuviolla.
                            "</string>
    <string name="licenses">"Lisenssit"</string>
