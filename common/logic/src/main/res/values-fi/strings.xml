    <string name="account_sync">"Tilin synkronointi"</string>
    <string name="account_sync_description">"
                                Google Drive -tilin synkronoinnin
                                ottaminen käyttöön tässä sovelluksessa
                                mahdollistaa sovelluksen tietojen,
                                kuten muistiinpanojen ja asetusten,
                                saumattoman varmuuskopioinnin ja
                                synkronoinnin, varmistaen tietojesi turvallisuuden.
        "</string>
    <string name="assistant_configuration">"Avustajan määritykset"</string>
    <string name="assistant_configuration_description">"
                                Tekoälyavustaja on tekoälypohjainen
                                ohjelma, joka on suunniteltu auttamaan
                                sinua laajassa tehtävävalikoimassa
                                tässä sovelluksessa. Nämä avustajat
                                ymmärtävät luonnollista kieltä ja
                                vastaavat siihen, joten voit
                                kommunikoida niiden kanssa kuvan
                                tai tekstin avulla.
                            "</string>
    <string name="dark_mode">"Tumma tila"</string>
    <string name="dark_mode_description">"
                                Tämä tila on järjestelmänlaajuinen asetus,
                                joka muuttaa Android-sovelluksesi
                                käyttöliittymän taustavärin tummemmaksi.
                                Se on suunniteltu vähentämään silmien
                                rasitusta, parantamaan esteettömyyttä,
                                säästämään akkua ja parantamaan
                                käyttökokemusta.
                            "</string>
    <string name="sound_effect">"Äänitehoste"</string>
    <string name="sound_effect_description">"
                                Jetnote-sovelluksen yhteydessä
                                \'Äänitehoste\'-ominaisuus tarjoaa
                                käyttäjille äänipalautteen, kun he
                                käyttävät painikkeita ja muita
                                käyttöliittymäelementtejä. Tämä on
                                yleinen käytäntö mobiilisovelluskehityksessä,
                                jotta käyttökokemus olisi interaktiivisempi
                                ja mukaansatempaavampi.
                            "</string>
    <string name="layouts">"Asettelut"</string>
    <string name="layouts_description">"
                                Asettelut ovat keskeisiä sisällön
                                järjestämisessä ja näyttämisessä
                                Android-sovelluksissasi.
                                Ne määrittävät käyttöliittymäelementtien
                                rakenteen ja järjestyksen näytöllä.
                            "</string>
