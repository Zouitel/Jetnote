    <string name="account_sync_description">"
                                تتيح لك مزامنة حساب Google Drive
                                في هذا التطبيق نسخ بياناتك احتياطياً
                                ومزامنتها بسلاسة،
                                مثل الملاحظات والإعدادات،
                                مما يضمن أمان بياناتك.
        "</string>
    <string name="assistant_configuration">"إعداد المساعد"</string>
    <string name="assistant_configuration_description">"
                                مساعد AI هو برنامج
                                مدعوم بالذكاء الاصطناعي مصمم
                                لمساعدتك في مجموعة واسعة من المهام
                                داخل هذا التطبيق.
                                يفهم هؤلاء المساعدون اللغة الطبيعية
                                ويستجيبون لها، مما يتيح لك
                                التفاعل معهم عبر الصورة أو النص.
                            "</string>
    <string name="dark_mode">"الوضع الداكن"</string>
    <string name="dark_mode_description">"
                                هذا الوضع هو إعداد على مستوى النظام
                                يحوّل نظام ألوان خلفية واجهة
                                تطبيق Android إلى ألوان داكنة.
                                تم تصميمه لتقليل إجهاد العينين،
                                وتحسين إمكانية الوصول، وتوفير
                                عمر البطارية، وتعزيز تجربة المستخدم.
                            "</string>
    <string name="sound_effect">"المؤثرات الصوتية"</string>
    <string name="sound_effect_description">"
                                في سياق تطبيق Jetnote،
                                توفر ميزة \"المؤثرات الصوتية\"
                                ردود فعل صوتية للمستخدمين عند
                                تفاعلهم مع الأزرار وعناصر
                                واجهة المستخدم الأخرى.
                                هذه ممارسة شائعة في تطوير
                                تطبيقات الجوال لجعل تجربة
                                المستخدم أكثر تفاعلاً وجاذبية.
                            "</string>
    <string name="layouts">"التخطيطات"</string>
    <string name="layouts_description">"
                                التخطيطات أساسية لتنظيم
                                المحتوى وعرضه في تطبيقات
                                Android الخاصة بك.
                                فهي تحدد بنية عناصر واجهة
                                المستخدم وترتيبها على الشاشة.
                            "</string>
    <string name="sort_notes">"ترتيب الملاحظات"</string>
