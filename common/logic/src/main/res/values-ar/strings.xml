    <string name="newest_sort">"الأحدث"</string>
    <string name="priority_sort">"الأولوية"</string>
    <string name="zen_mode">"وضع Zen"</string>
    <string name="zen_mode_description">"
                                وضع Zen (وضع ملء الشاشة) هو إعداد
                                عرض في الحوسبة يتيح للتطبيق
                                احتلال الشاشة بالكامل، مع إخفاء
                                جميع عناصر الواجهة الأخرى مثل
                                أشرطة الأدوات والقوائم وشريط
                                المهام أو شريط القوائم الخاص
                                بنظام التشغيل.
                            "</string>
    <string name="shake">"الاهتزاز للإبلاغ"</string>
    <string name="shake_description">"
                              إنها ميزة مريحة تتيح للمستخدمين
                              بدء عملية الإبلاغ عن ملاحظة أو خطأ
                              ببساطة عن طريق هز جهاز Android
                              فعلياً. بدلاً من التنقل عبر
                              قوائم متعددة للعثور على خيار
                              \"إرسال بلاغ\" أو \"الإبلاغ عن خطأ\"،
                            "</string>
    <string name="block_screenshot">"حظر لقطة الشاشة"</string>
    <string name="block_screenshot_description">"
                                حظر لقطات الشاشة هو إجراء أمني
                                يمنع المستخدمين من التقاط
                                لقطات شاشة لمحتوى تطبيقك.
                                يُستخدم هذا عادةً لحماية
                                المعلومات الحساسة، مثل بيانات
                                البنك والبيانات الشخصية
                                أو المواد المحمية بحقوق الطبع والنشر.
                            "</string>
    <string name="lock_mode">"وضع القفل"</string>
    <string name="lock_mode_description">"
                                تعزز هذه الميزة أمان تطبيقك
                                من خلال مطالبة المستخدمين
                                بالمصادقة قبل الوصول إلى محتواه.
                                يتم تحقيق ذلك عادةً باستخدام
                                ميزات الأمان المدمجة في الجهاز،
                                مثل بصمة الإصبع أو رمز PIN
                                أو النمط.
                            "</string>
    <string name="licenses">"التراخيص"</string>
    <string name="licenses_description">"
                                تم تضمين هذه التراخيص هنا للامتثال
                                لمتطلبات التوزيع الخاصة بالمؤلفين
                                المعنيين وتوفير الشفافية فيما يتعلق
                                ببنية البرنامج.
                                "</string>
