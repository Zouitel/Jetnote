    <string name="account_sync">"Sincronización de cuenta"</string>
    <string name="account_sync_description">"
                                Activar la sincronización de cuenta de
                                Google Drive para esta aplicación te
                                permite hacer una copia de seguridad y
                                sincronizar datos de la app, como notas
                                y ajustes, garantizando que tus datos
                                estén seguros.
        "</string>
    <string name="assistant_configuration">"Configuración del asistente"</string>
    <string name="assistant_configuration_description">"
                                El asistente de IA es un programa de
                                software impulsado por inteligencia
                                artificial diseñado para ayudarte con
                                una amplia gama de tareas en esta
                                aplicación. Estos asistentes entienden y
                                responden al lenguaje natural, permitiéndote
                                interactuar con ellos mediante imágenes o texto.
                            "</string>
    <string name="dark_mode">"Modo oscuro"</string>
    <string name="dark_mode_description">"
                                Este modo es una configuración del sistema
                                que cambia el esquema de fondo de la
                                interfaz de tu app Android a colores más
                                oscuros. Está diseñado para reducir la
                                fatiga visual, mejorar la accesibilidad,
                                ahorrar batería y mejorar la experiencia
                                del usuario.
                            "</string>
    <string name="sound_effect">"Efecto de sonido"</string>
    <string name="sound_effect_description">"
                                En el contexto de la aplicación Jetnote,
                                la función de efecto de sonido proporciona
                                retroalimentación auditiva cuando los
                                usuarios interactúan con botones y otros
                                elementos de la interfaz. Es una práctica
                                común en el desarrollo de apps móviles
                                para hacer la experiencia más interactiva
                                y atractiva.
                            "</string>
    <string name="layouts">"Diseños"</string>
    <string name="layouts_description">"
                                Los diseños son fundamentales para organizar
                                y mostrar contenido en tus aplicaciones
                                Android. Definen la estructura y disposición
                                de los elementos de la interfaz en la pantalla.
                            "</string>
    <string name="sort_notes">"Ordenar notas"</string>
    <string name="default_sort">"predeterminado"</string>
    <string name="name_sort">"nombre"</string>
    <string name="oldest_sort">"más antiguo"</string>
    <string name="newest_sort">"más nuevo"</string>
    <string name="priority_sort">"prioridad"</string>
    <string name="zen_mode">"Modo Zen"</string>
    <string name="zen_mode_description">"
                                El modo Zen (pantalla completa) es una
                                configuración de visualización que permite
                                a una aplicación ocupar toda la pantalla,
                                ocultando todos los demás elementos de la
                                interfaz como barras de herramientas, menús
                                y la barra de tareas del sistema operativo.
                            "</string>
    <string name="shake">"Agitar para reportar"</string>
    <string name="shake_description">"
                              Es una función conveniente que permite a
                              los usuarios iniciar un proceso de
                              retroalimentación o reporte de errores
                              simplemente agitando físicamente su
                              dispositivo Android, sin necesidad de
                              navegar por múltiples menús.
                            "</string>
    <string name="block_screenshot">"Bloquear captura de pantalla"</string>
    <string name="block_screenshot_description">"
                                El bloqueo de capturas de pantalla es una
                                medida de seguridad que impide a los
                                usuarios capturar el contenido de tu app.
                                Se utiliza para proteger información
                                sensible como datos bancarios, datos
                                personales o material protegido por
                                derechos de autor.
                            "</string>
    <string name="lock_mode">"Modo de bloqueo"</string>
    <string name="lock_mode_description">"
                                Esta función mejora la seguridad de tu
                                app requiriendo que los usuarios se
                                autentiquen antes de acceder a su
                                contenido. Esto se logra mediante las
                                funciones de seguridad integradas del
                                dispositivo, como huella dactilar, PIN
                                o patrón de desbloqueo.
                            "</string>
    <string name="licenses">"Licencias"</string>
    <string name="licenses_description">"
