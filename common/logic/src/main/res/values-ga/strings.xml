    <string name="account_sync">"Sioncronú Cuntais"</string>
    <string name="account_sync_description">"
                                Trí shioncronú cuntas Google Drive a chumasú
                                don aip seo, is féidir leat do chuid sonraí
                                aipe, cosúil le nótaí agus socruithe,
                                a chúltaca agus a shioncrónú go seamless,
                                rud a chinntíonn go bhfuil do chuid sonraí
                                slán sábháilte.
        "</string>
    <string name="assistant_configuration">"Cumraíocht an Chúntóra"</string>
    <string name="assistant_configuration_description">"
                                Is clár bogearraí é an cúntóir AI atá
                                cumhachtaithe ag intleacht shaorga,
                                deartha chun cabhrú leat le raon leathan
                                cúraimí san aip seo. Tuigeann na cúntóirí
                                seo teanga nádúrtha agus freagraíonn siad
                                dó, rud a cheadaíonn duit idirghníomhú
                                leo trí íomhá nó téacs.
                            "</string>
    <string name="dark_mode">"Mód Dorcha"</string>
    <string name="dark_mode_description">"
                                Is socrú córas-leathan é an mód seo a
                                athraíonn scéim chúlra chomhéadan d\'aip
                                Android do dhathanna níos dorcha.
                                Tá sé deartha chun strus súl a laghdú,
                                inrochtaineacht a fheabhsú, an ceallra
                                a shábháil agus taithí an úsáideora
                                a fheabhsú.
                            "</string>
    <string name="sound_effect">"Éifeacht Fuaime"</string>
    <string name="sound_effect_description">"
                                I gcomhthéacs fheidhmchlár Jetnote,
                                soláthraíonn an ghné \'Éifeacht Fuaime\'
                                aiseolas éisteachta d\'úsáideoirí nuair a
                                idirghníomhaíonn siad le cnaipí agus
                                eilimintí comhéadain eile. Is cleachtas
                                coitianta é seo i bhforbairt aipeanna
                                móibíleacha chun taithí an úsáideora
                                a dhéanamh níos idirghníomhaí agus
                                níos tarraingteach.
                            "</string>
    <string name="layouts">"Leaganacha Amach"</string>
    <string name="layouts_description">"
                                Tá leaganacha amach bunúsach chun ábhar
                                a eagrú agus a thaispeáint i d\'aipeanna
                                Android. Sainmhínítear leo struchtúr agus
                                socrú eilimintí comhéadain ar an scáileán.
                            "</string>
    <string name="sort_notes">"Sórtáil Nótaí"</string>
    <string name="default_sort">"réamhshocrú"</string>
    <string name="name_sort">"ainm"</string>
    <string name="oldest_sort">"is sine"</string>
    <string name="newest_sort">"is nuaí"</string>
    <string name="priority_sort">"tosaíocht"</string>
    <string name="zen_mode">"Mód Zen"</string>
    <string name="zen_mode_description">"
                                Is socrú taispeána é Mód Zen (mód lánscáileáin)
                                a ligeann d\'aip an scáileán ar fad a áitiú,
                                ag folú gach eilimint comhéadain eile
                                cosúil le barraí uirlisí, roghchláir agus
                                barra tascanna an chórais oibriúcháin.
                            "</string>
    <string name="shake">"Croith chun Tuairisciú"</string>
    <string name="shake_description">"
                              Is gné áisiúil í seo a ligeann d\'úsáideoirí
                              próiseas aiseolais nó tuairiscithe fabhtanna
                              a thosú ach a ngléas Android a chroitheadh
                              go fisiciúil. In ionad nascleanúint a dhéanamh
                              trí iliomad roghchláir chun \'Seol Aiseolas\'
                              nó \'Tuairiscigh Fabht\' a aimsiú.
                            "</string>
    <string name="block_screenshot">"Bloc Gabháil Scáileáin"</string>
    <string name="block_screenshot_description">"
                                Is beart slándála é blocáil gabháil scáileáin
                                a chuireann cosc ar úsáideoirí ó ghabháil
                                scáileán d\'ábhar d\'aipe. Úsáidtear é seo
                                go minic chun faisnéis íogair a chosaint,
                                cosúil le sonraí baincéireachta, sonraí
                                pearsanta nó ábhar atá faoi chosaint
                                cóipchirt.
                            "</string>
    <string name="lock_mode">"Mód Glasála"</string>
    <string name="lock_mode_description">"
                                Feabhsaíonn an ghné seo slándáil d\'aipe
                                trí éileamh ar úsáideoirí fíordheimhniú
                                a dhéanamh sula bhféadfaidh siad rochtain
                                a fháil ar a ábhar. Baintear é seo amach
                                de ghnáth ag baint úsáide as gnéithe
                                slándála ionsuite an ghléis, cosúil le
                                méarlorg, PIN nó patrún díghlasála.
                            "</string>
    <string name="licenses">"Ceadúnais"</string>
    <string name="licenses_description">"
                                    Tá na ceadúnais seo san áireamh anseo
                                    chun cloí le riachtanais dáilte na
                                    n-údar faoi seach agus chun trédhearcacht
                                    a sholáthar maidir le hailtireacht
                                    an bhogearraí.
                                    "</string>
