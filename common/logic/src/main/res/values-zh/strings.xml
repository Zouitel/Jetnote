    <string name="zen_mode">"专注模式"</string>
    <string name="zen_mode_description">"
                                专注模式（全屏模式）是一种显示设置，
                                允许应用占据整个屏幕，
                                隐藏所有其他界面元素，
                                如工具栏、菜单以及操作系统的
                                任务栏或菜单栏。
                            "</string>
    <string name="shake">"摇一摇反馈"</string>
    <string name="shake_description">"
                              这是一项便捷功能，
                              允许用户通过物理摇晃 Android 设备
                              来启动反馈或错误报告流程。
                              无需在多个菜单中查找
                              '发送反馈'或'报告错误'选项，
                              即可轻松完成。
                            "</string>
    <string name="block_screenshot">"禁止截图"</string>
    <string name="block_screenshot_description">"
                                截图拦截是一种安全措施，
                                可防止用户截取应用内容的屏幕截图。
                                通常用于保护敏感信息，
                                如银行详情、个人数据
                                或受版权保护的内容。
                            "</string>
    <string name="lock_mode">"锁定模式"</string>
    <string name="lock_mode_description">"
                                此功能通过要求用户在访问
                                应用内容前进行身份验证来增强安全性。
                                通常通过设备内置的安全功能实现，
                                如指纹、PIN 码或图案解锁。
                            "</string>
    <string name="licenses">"许可证"</string>
    <string name="licenses_description">"
