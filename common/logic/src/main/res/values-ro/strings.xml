    <string name="account_sync">"Sincronizare cont"</string>
    <string name="account_sync_description">"
                                Activarea sincronizării contului Google Drive
                                pentru această aplicație vă permite să
                                faceți backup și să sincronizați fără
                                probleme datele aplicației, cum ar fi
                                notele și setările, asigurând că
                                datele dvs. sunt în siguranță.
        "</string>
    <string name="assistant_configuration">"Configurare asistent"</string>
    <string name="assistant_configuration_description">"
                                Asistentul AI este un program software
                                alimentat de inteligența artificială,
                                conceput pentru a vă ajuta cu o gamă
                                largă de sarcini în această aplicație.
                                Acești asistenți înțeleg și răspund la
                                limbajul natural, permițându-vă să
                                interacționați cu ei prin imagine sau text.
                            "</string>
    <string name="dark_mode">"Mod întunecat"</string>
    <string name="dark_mode_description">"
                                Acest mod este o setare la nivel de sistem
                                care schimbă schema de fundal a interfeței
                                aplicației Android în culori mai închise.
                                Este conceput pentru a reduce oboseala
                                ochilor, a îmbunătăți accesibilitatea,
                                a economisi bateria și a îmbunătăți
                                experiența utilizatorului.
                            "</string>
    <string name="sound_effect">"Efect sonor"</string>
    <string name="sound_effect_description">"
                                În contextul aplicației Jetnote,
                                funcția \'Efect sonor\' oferă feedback
                                auditiv utilizatorilor atunci când
                                interacționează cu butoanele și alte
                                elemente ale interfeței.
                                Aceasta este o practică comună în
                                dezvoltarea aplicațiilor mobile pentru
                                a face experiența utilizatorului mai
                                interactivă și mai captivantă.
                            "</string>
    <string name="layouts">"Aspecte"</string>
    <string name="layouts_description">"
                                Aspectele sunt fundamentale pentru
                                organizarea și afișarea conținutului
                                în aplicațiile Android.
                                Ele definesc structura și aranjamentul
                                elementelor de interfață pe ecran.
                            "</string>
    <string name="sort_notes">"Sortează notele"</string>
    <string name="default_sort">"implicit"</string>
    <string name="name_sort">"nume"</string>
    <string name="oldest_sort">"cele mai vechi"</string>
    <string name="newest_sort">"cele mai noi"</string>
    <string name="priority_sort">"prioritate"</string>
    <string name="zen_mode">"Modul Zen"</string>
    <string name="zen_mode_description">"
                                Modul Zen (ecran complet) este o setare
                                de afișare care permite unei aplicații
                                să ocupe întregul ecran, ascunzând toate
                                celelalte elemente de interfață, cum ar fi
                                barele de instrumente, meniurile și bara
                                de activități a sistemului de operare.
                            "</string>
    <string name="shake">"Agită pentru a raporta"</string>
    <string name="shake_description">"
                              Este o funcție convenabilă care le permite
                              utilizatorilor să inițieze un proces de
                              feedback sau raportare a erorilor pur și
                              simplu agitând fizic dispozitivul lor Android.
                              În loc să navigați prin mai multe meniuri
                              pentru a găsi \'Trimite feedback\' sau
                              \'Raportează o eroare\'.
                            "</string>
    <string name="block_screenshot">"Blochează captura de ecran"</string>
    <string name="block_screenshot_description">"
                                Blocarea capturilor de ecran este o
                                măsură de securitate care îi împiedică
                                pe utilizatori să facă capturi de ecran
                                ale conținutului aplicației dvs.
                                Este adesea folosită pentru a proteja
                                informații sensibile, cum ar fi detalii
                                bancare, date personale sau material
                                protejat prin drepturi de autor.
                            "</string>
    <string name="lock_mode">"Mod blocare"</string>
    <string name="lock_mode_description">"
                                Această funcție îmbunătățește securitatea
                                aplicației dvs. cerând utilizatorilor să
                                se autentifice înainte de a accesa conținutul.
                                Aceasta se realizează de obicei folosind
                                funcțiile de securitate încorporate ale
                                dispozitivului, cum ar fi amprentă, PIN
                                sau deblocare prin model.
                            "</string>
    <string name="licenses">"Licențe"</string>
