    <string name="zen_mode">"Zen-Modus"</string>
    <string name="zen_mode_description">"
                                Der Zen-Modus (Vollbildmodus) ist eine
                                Anzeigeeinstellung, bei der eine Anwendung
                                den gesamten Bildschirm einnimmt und alle
                                anderen Schnittstellenelemente wie
                                Symbolleisten, Menüs und die Taskleiste
                                des Betriebssystems ausblendet.
                            "</string>
    <string name="shake">"Schütteln zum Melden"</string>
    <string name="shake_description">"
                              Dies ist eine praktische Funktion, mit der
                              Benutzer einen Feedback- oder
                              Fehlermeldeprozess einleiten können, indem
                              sie ihr Android-Gerät einfach schütteln.
                              Anstatt durch mehrere Menüs zu navigieren,
                              um eine Option „Feedback senden" oder
                              „Fehler melden" zu finden.
                            "</string>
    <string name="block_screenshot">"Screenshot blockieren"</string>
    <string name="block_screenshot_description">"
                                Das Blockieren von Screenshots ist eine
                                Sicherheitsmaßnahme, die verhindert, dass
                                Benutzer Screenshots des App-Inhalts
                                erstellen. Dies wird häufig verwendet, um
                                vertrauliche Informationen wie Bankdaten,
                                persönliche Daten oder urheberrechtlich
                                geschütztes Material zu schützen.
                            "</string>
    <string name="lock_mode">"Sperrmodus"</string>
    <string name="lock_mode_description">"
                                Diese Funktion erhöht die Sicherheit Ihrer
                                App, indem Benutzer sich authentifizieren
                                müssen, bevor sie auf deren Inhalte
                                zugreifen können. Dies wird in der Regel
                                mithilfe der integrierten
                                Sicherheitsfunktionen des Geräts erreicht,
                                wie Fingerabdruck, PIN oder Muster.
                            "</string>
    <string name="licenses">"Lizenzen"</string>
    <string name="licenses_description">"
                                    Diese Lizenzen sind hier enthalten, um
                                    den Verteilungsanforderungen der
                                    jeweiligen Autoren zu entsprechen und
                                    Transparenz hinsichtlich der
                                    Softwarearchitektur zu gewährleisten.
                                    "</string>
