    <string name="account_sync">"Kontosynchronisierung"</string>
    <string name="account_sync_description">"
                                Die Aktivierung der Google Drive-Kontosynchronisierung
                                für diese Anwendung ermöglicht es Ihnen,
                                Ihre App-Daten wie Notizen und
                                Einstellungen nahtlos zu sichern und zu
                                synchronisieren, damit Ihre Daten sicher sind.
        "</string>
    <string name="assistant_configuration">"Assistentenkonfiguration"</string>
    <string name="assistant_configuration_description">"
                                Der KI-Assistent ist ein von künstlicher
                                Intelligenz betriebenes Softwareprogramm,
                                das Ihnen bei einer Vielzahl von Aufgaben
                                in dieser Anwendung helfen soll.
                                Diese Assistenten verstehen natürliche Sprache
                                und reagieren darauf, sodass Sie über
                                Bilder oder Text mit ihnen interagieren können.
                            "</string>
    <string name="dark_mode">"Dunkelmodus"</string>
    <string name="dark_mode_description">"
                                Dieser Modus ist eine systemweite Einstellung,
                                die das Hintergrundfarbschema der
                                Android-App-Benutzeroberfläche auf dunklere
                                Farben umstellt. Er dient dazu, die
                                Augenbelastung zu reduzieren, die
                                Zugänglichkeit zu verbessern, den Akku zu
                                schonen und das Benutzererlebnis zu verbessern.
                            "</string>
    <string name="sound_effect">"Soundeffekt"</string>
    <string name="sound_effect_description">"
                                Im Kontext der Jetnote-Anwendung bietet
                                die Funktion „Soundeffekt" akustisches
                                Feedback, wenn Benutzer mit Schaltflächen
                                und anderen UI-Elementen interagieren.
                                Dies ist eine gängige Praxis in der
                                mobilen App-Entwicklung, um das
                                Benutzererlebnis interaktiver und
                                ansprechender zu gestalten.
                            "</string>
    <string name="layouts">"Layouts"</string>
    <string name="layouts_description">"
                                Layouts sind grundlegend für die Organisation
                                und Anzeige von Inhalten in Ihren
                                Android-Anwendungen.
                                Sie definieren die Struktur und Anordnung
                                der UI-Elemente auf dem Bildschirm.
                            "</string>
