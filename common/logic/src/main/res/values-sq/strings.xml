    <string name="zen_mode">"Modaliteti Zen"</string>
    <string name="zen_mode_description">"
                                Modaliteti Zen (ekran i plotë) është një
                                cilësim ekrani që lejon aplikacionin të
                                zërë të gjithë ekranin, duke fshehur të
                                gjitha elementet e tjera të ndërfaqes si
                                shiritat e veglave, menytë dhe shiriti i
                                detyrave i sistemit operativ.
                            "</string>
    <string name="shake">"Tunde për të raportuar"</string>
    <string name="shake_description">"
                              Është një funksion i përshtatshëm që u lejon
                              përdoruesve të iniciojnë një proces komentesh
                              ose raportimi të gabimeve thjesht duke
                              tundur fizikisht pajisjen e tyre Android.
                              Në vend të lundrimit nëpër meny të shumta
                              për të gjetur \'Dërgo komente\' ose
                              \'Raporto një gabim\'.
                            "</string>
    <string name="block_screenshot">"Blloko pamjen e ekranit"</string>
    <string name="block_screenshot_description">"
                                Bllokimi i pamjeve të ekranit është një
                                masë sigurie që pengon përdoruesit të
                                kapin pamje të ekranit të përmbajtjes
                                së aplikacionit tuaj. Shpesh përdoret
                                për të mbrojtur informacione të ndjeshme,
                                si të dhënat bankare, të dhënat personale
                                ose materialin e mbrojtur me të drejtë
                                autori.
                            "</string>
    <string name="lock_mode">"Modaliteti i bllokimit"</string>
    <string name="lock_mode_description">"
                                Ky funksion rrit sigurinë e aplikacionit
                                tuaj duke kërkuar nga përdoruesit të
                                vërtetojnë identitetin para se të
                                aksesojnë përmbajtjen e tij.
                                Kjo zakonisht arrihet duke përdorur
                                funksionet e integruara të sigurisë të
                                pajisjes, si gjurmën e gishtit, PIN-in
                                ose modelin e zhbllokimit.
                            "</string>
