    <string name="account_sync">"Sinkronizimi i llogarisë"</string>
    <string name="account_sync_description">"
                                Aktivizimi i sinkronizimit të llogarisë
                                Google Drive për këtë aplikacion ju lejon
                                të rezervoni dhe sinkronizoni të dhënat
                                tuaja, si shënime dhe cilësime, pa
                                ndërprerje, duke siguruar që të dhënat
                                tuaja janë të sigurta.
        "</string>
    <string name="assistant_configuration">"Konfigurimi i asistentit"</string>
    <string name="assistant_configuration_description">"
                                Asistenti AI është një program software
                                i mundësuar nga inteligjenca artificiale,
                                i krijuar për t\'ju ndihmuar me një gamë
                                të gjerë detyrash në këtë aplikacion.
                                Këta asistentë kuptojnë dhe u përgjigjen
                                gjuhës natyrore, duke ju lejuar të
                                ndërveproni me ta nëpërmjet imazhit ose tekstit.
                            "</string>
    <string name="dark_mode">"Modaliteti i errët"</string>
    <string name="dark_mode_description">"
                                Ky modalitet është një cilësim i të gjithë
                                sistemit që ndryshon skemën e sfondit të
                                ndërfaqes së aplikacionit tuaj Android
                                në ngjyra më të errëta.
                                Është projektuar për të reduktuar lodhjen
                                e syve, për të përmirësuar aksesueshmërinë,
                                për të kursyer baterinë dhe për të
                                përmirësuar përvojën e përdoruesit.
                            "</string>
    <string name="sound_effect">"Efekt zanor"</string>
    <string name="sound_effect_description">"
                                Në kontekstin e aplikacionit Jetnote,
                                funksioni \'Efekt zanor\' ofron reagim
                                dëgjimor për përdoruesit kur ndërveprojnë
                                me butonat dhe elementet e tjera të ndërfaqes.
                                Kjo është një praktikë e zakonshme në
                                zhvillimin e aplikacioneve mobile për të
                                bërë përvojën e përdoruesit më interaktive
                                dhe tërheqëse.
                            "</string>
    <string name="layouts">"Paraqitjet"</string>
    <string name="layouts_description">"
                                Paraqitjet janë themelore për organizimin
                                dhe shfaqjen e përmbajtjes në aplikacionet
                                tuaja Android. Ato përcaktojnë strukturën
                                dhe rregullimin e elementeve të ndërfaqes
                                në ekran.
                            "</string>
