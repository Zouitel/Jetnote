    <string name="account_sync">"Kontosynkronisering"</string>
    <string name="account_sync_description">"
                                Aktivering av Google Drive-kontosynkronisering
                                for denne applikasjonen lar deg sikkerhets­kopiere
                                og synkronisere appdata, som notater og
                                innstillinger, på en sømløs måte,
                                og sikrer at dataene dine er trygge.
        "</string>
    <string name="assistant_configuration">"Assistentkonfigurasjon"</string>
    <string name="assistant_configuration_description">"
                                AI-assistenten er et program drevet av
                                kunstig intelligens, designet for å hjelpe
                                deg med et bredt spekter av oppgaver i
                                denne applikasjonen.
                                Disse assistentene forstår og svarer på
                                naturlig språk, slik at du kan samhandle
                                med dem gjennom bilde eller tekst.
                            "</string>
    <string name="dark_mode">"Mørk modus"</string>
    <string name="dark_mode_description">"
                                Denne modusen er en systemomfattende
                                innstilling som endrer bakgrunnsfargen
                                i Android-appens brukergrensesnitt til
                                mørkere farger.
                                Den er utformet for å redusere øye­anstrengelse,
                                forbedre tilgjengelighet, spare batteri
                                og forbedre brukeropplevelsen.
                            "</string>
    <string name="sound_effect">"Lydeffekt"</string>
    <string name="sound_effect_description">"
                                I Jetnote-applikasjonen gir funksjonen
                                \'Lydeffekt\' auditiv tilbakemelding til
                                brukerne når de samhandler med knapper
                                og andre UI-elementer.
                                Dette er vanlig praksis innen mobilapp­utvikling
                                for å gjøre brukeropplevelsen mer
                                interaktiv og engasjerende.
                            "</string>
    <string name="layouts">"Layouter"</string>
    <string name="layouts_description">"
                                Layouter er grunnleggende for å organisere
                                og vise innhold i Android-applikasjoner.
                                De definerer strukturen og oppsettet av
                                UI-elementer på skjermen.
                            "</string>
