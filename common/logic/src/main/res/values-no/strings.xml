    <string name="zen_mode">"Zen-modus"</string>
    <string name="zen_mode_description">"
                                Zen-modus (fullskjerm) er en skjerm­innstilling
                                som lar en applikasjon fylle hele skjermen
                                og skjuler alle andre grensesnitt­elementer
                                som verktøylinjer, menyer og operativ­systemets
                                oppgavelinje.
                            "</string>
    <string name="shake">"Rist for å rapportere"</string>
    <string name="shake_description">"
                              Dette er en praktisk funksjon som lar brukere
                              starte en tilbakemeldings- eller feilrapporterings­prosess
                              ved å riste Android-enheten fysisk.
                              I stedet for å navigere gjennom flere menyer
                              for å finne \'Send tilbakemelding\' eller
                              \'Rapporter en feil\'.
                            "</string>
    <string name="block_screenshot">"Blokker skjermbilde"</string>
    <string name="block_screenshot_description">"
                                Blokkering av skjermbilder er et sikkerhets­tiltak
                                som hindrer brukere fra å ta skjermbilder
                                av appens innhold.
                                Det brukes ofte for å beskytte sensitiv
                                informasjon, som bankdetaljer, persondata
                                eller opphavsrettsbeskyttet materiale.
                            "</string>
    <string name="lock_mode">"Låsemodus"</string>
    <string name="lock_mode_description">"
                                Denne funksjonen forbedrer sikkerheten i
                                appen din ved å kreve at brukere autentiserer
                                seg før de kan få tilgang til innholdet.
                                Dette oppnås vanligvis ved hjelp av enhetens
                                innebygde sikkerhetsfunksjoner, som
                                fingeravtrykk, PIN eller mønster­opplåsing.
                            "</string>
    <string name="licenses">"Lisenser"</string>
    <string name="licenses_description">"
                                    Disse lisensene er inkludert her for å
                                    overholde distribusjonskravene til de
                                    respektive forfatterne og for å gi
                                    åpenhet om programmets arkitektur.
                                    "</string>
