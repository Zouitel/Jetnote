    <string name="zen_mode">"Zen-ham"</string>
    <string name="zen_mode_description">"
                                Zen-hamur (heilskjáhamur) er skjástilling
                                sem leyfir forriti að fylla allan skjáinn
                                og fela allar aðrar viðmótseiningar eins
                                og tækjastikur, valmyndir og verkefnastiku
                                stýrikerfisins.
                            "</string>
    <string name="shake">"Hrista til að tilkynna"</string>
    <string name="shake_description">"
                              Þetta er þægileg eiginleiki sem gerir notendum
                              kleift að hefja endurgjafar- eða villutilkynningarferli
                              með því einfaldlega að hrista Android-tækið
                              líkamlega. Í stað þess að fara í gegnum
                              margar valmyndir til að finna \'Senda endurgjöf\'
                              eða \'Tilkynna villu\'.
                            "</string>
    <string name="block_screenshot">"Loka fyrir skjámyndatöku"</string>
    <string name="block_screenshot_description">"
                                Lokun á skjámyndatöku er öryggisráðstöfun
                                sem kemur í veg fyrir að notendur taki
                                skjámyndir af efni forritsins.
                                Þetta er oft notað til að vernda viðkvæmar
                                upplýsingar, eins og bankagögn,
                                persónuleg gögn eða höfundarréttarverndað efni.
                            "</string>
    <string name="lock_mode">"Læsingarhamur"</string>
    <string name="lock_mode_description">"
                                Þessi eiginleiki eykur öryggi forritsins
                                með því að krefjast þess að notendur
                                sanni á sér deili áður en þeir fá aðgang
                                að efni þess. Þetta er venjulega gert með
                                innbyggðum öryggisaðgerðum tækisins,
                                eins og fingrafaralæsingu, PIN-kóða eða mynstri.
                            "</string>
    <string name="licenses">"Leyfi"</string>
    <string name="licenses_description">"
                                    Þessi leyfi eru með hér til að uppfylla
                                    dreifingarskilyrði viðkomandi höfunda
                                    og til að veita gagnsæi varðandi
                                    uppbyggingu hugbúnaðarins.
                                    "</string>
