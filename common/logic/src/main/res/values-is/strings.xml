    <string name="account_sync">"Samstilling reiknings"</string>
    <string name="account_sync_description">"
                                Að virkja Google Drive reikningssamstillingu
                                fyrir þetta forrit gerir þér kleift að
                                geyma afrit og samstilla forritsgögn,
                                eins og glósur og stillingar, á þægilegan
                                hátt og tryggir öryggi gagnanna þinna.
        "</string>
    <string name="assistant_configuration">"Stilling aðstoðarmanns"</string>
    <string name="assistant_configuration_description">"
                                Gervigreindur aðstoðarmaður er hugbúnaðarforrit
                                knúið af gervigreind, hannað til að hjálpa
                                þér með fjölbreyttar verkefni í þessu forriti.
                                Þessir aðstoðarmenn skilja og svara náttúrulegu
                                máli, sem gerir þér kleift að eiga samskipti
                                við þá í gegnum mynd eða texta.
                            "</string>
    <string name="dark_mode">"Dökkt ham"</string>
    <string name="dark_mode_description">"
                                Þetta ham er kerfisvíð stilling sem breytir
                                bakgrunnslit Android-forritsins í dekkri liti.
                                Það er hannað til að draga úr álagi á augu,
                                bæta aðgengi, spara rafhlöðu og bæta
                                upplifun notandans.
                            "</string>
    <string name="sound_effect">"Hljóðbrellur"</string>
    <string name="sound_effect_description">"
                                Í samhengi Jetnote-forritsins veitir
                                \'Hljóðbrellur\' aðgerðin notendum
                                hljóðlegar viðbrögð þegar þeir nota
                                hnappa og önnur viðmótseiningar.
                                Þetta er algeng venja í þróun farsímaforrita
                                til að gera upplifun notandans meira
                                gagnvirka og grípandi.
                            "</string>
    <string name="layouts">"Útlit"</string>
    <string name="layouts_description">"
                                Útlit eru grundvallandi til að skipuleggja
                                og sýna efni í Android-forritunum þínum.
                                Þau skilgreina uppbyggingu og fyrirkomulag
                                viðmótseininga á skjánum.
                            "</string>
