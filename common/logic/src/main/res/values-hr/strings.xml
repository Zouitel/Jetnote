    <string name="account_sync">"Sinkronizacija računa"</string>
    <string name="account_sync_description">"
                                Omogućavanje sinkronizacije Google Drive
                                računa za ovu aplikaciju omogućuje vam
                                besprijekorno sigurnosno kopiranje i
                                sinkronizaciju podataka aplikacije, poput
                                bilješki i postavki, čime se osigurava
                                sigurnost vaših podataka.
        "</string>
    <string name="assistant_configuration">"Konfiguracija asistenta"</string>
    <string name="assistant_configuration_description">"
                                AI asistent je softverski program pokrenut
                                umjetnom inteligencijom, dizajniran da vam
                                pomogne s nizom zadataka u ovoj aplikaciji.
                                Ovi asistenti razumiju i odgovaraju na
                                prirodni jezik, omogućujući vam interakciju
                                putem slike ili teksta.
                            "</string>
    <string name="dark_mode">"Tamni način rada"</string>
    <string name="dark_mode_description">"
                                Ovaj način rada je postavka koja mijenja
                                shemu pozadine korisničkog sučelja vaše
                                Android aplikacije u tamnije boje.
                                Dizajniran je za smanjenje naprezanja
                                očiju, poboljšanje pristupačnosti,
                                uštedu baterije i poboljšanje
                                korisničkog iskustva.
                            "</string>
    <string name="sound_effect">"Zvučni efekt"</string>
    <string name="sound_effect_description">"
                                U kontekstu aplikacije Jetnote, funkcija
                                \'Zvučni efekt\' pruža slušne povratne
                                informacije korisnicima kada stupaju u
                                interakciju s gumbima i ostalim elementima
                                sučelja. To je uobičajena praksa u razvoju
                                mobilnih aplikacija radi interaktivnijeg
                                i privlačnijeg korisničkog iskustva.
                            "</string>
    <string name="layouts">"Rasporedi"</string>
    <string name="layouts_description">"
                                Rasporedi su temeljni za organiziranje i
                                prikaz sadržaja u vašim Android aplikacijama.
                                Oni definiraju strukturu i raspored
                                elemenata sučelja na zaslonu.
                            "</string>
