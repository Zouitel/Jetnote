    <string name="zen_mode">"Zen način rada"</string>
    <string name="zen_mode_description">"
                                Zen način rada (cijeli zaslon) je postavka
                                zaslona koja omogućuje aplikaciji da zauzme
                                cijeli ekran, skrivajući sve ostale elemente
                                sučelja poput alatnih traka, izbornika i
                                trake zadataka operacijskog sustava.
                            "</string>
    <string name="shake">"Protresite za prijavu"</string>
    <string name="shake_description">"
                              Zgoda funkcija koja korisnicima omogućuje
                              pokretanje procesa povratnih informacija ili
                              prijave grešaka jednostavnim fizičkim
                              protresanjem Android uređaja. Umjesto
                              navigacije kroz više izbornika za pronalazak
                              \'Pošalji povratne informacije\' ili
                              \'Prijavi grešku\'.
                            "</string>
    <string name="block_screenshot">"Blokiraj snimku zaslona"</string>
    <string name="block_screenshot_description">"
                                Blokiranje snimki zaslona je sigurnosna
                                mjera koja sprječava korisnike da snimaju
                                zaslone sadržaja vaše aplikacije.
                                Često se koristi za zaštitu osjetljivih
                                informacija poput bankovnih podataka,
                                osobnih podataka ili materijala zaštićenih
                                autorskim pravom.
                            "</string>
    <string name="lock_mode">"Način zaključavanja"</string>
    <string name="lock_mode_description">"
                                Ova funkcija poboljšava sigurnost vaše
                                aplikacije zahtijevajući od korisnika
                                provjeru autentičnosti prije pristupa
                                sadržaju. Obično se postiže korištenjem
                                ugrađenih sigurnosnih funkcija uređaja,
                                poput otiska prsta, PIN-a ili uzorka
                                otključavanja.
                            "</string>
    <string name="licenses">"Licence"</string>
    <string name="licenses_description">"
