    <string name="account_sync">"Kontosynkronisering"</string>
    <string name="account_sync_description">"
                                Aktivering af Google Drive-synkronisering
                                for denne app giver dig mulighed for
                                problemfrit at sikkerhedskopiere og
                                synkronisere dine appdata, såsom noter
                                og indstillinger, og sikrer at dine
                                data er trygge.
        "</string>
    <string name="assistant_configuration">"Assistentkonfiguration"</string>
    <string name="assistant_configuration_description">"
                                AI-assistenten er et softwareprogram drevet
                                af kunstig intelligens, designet til at
                                hjælpe dig med en bred vifte af opgaver
                                i denne app. Disse assistenter forstår og
                                reagerer på naturligt sprog, hvilket giver
                                dig mulighed for at interagere med dem
                                via billede eller tekst.
                            "</string>
    <string name="dark_mode">"Mørk tilstand"</string>
    <string name="dark_mode_description">"
                                Denne tilstand er en systemomfattende
                                indstilling, der skifter baggrundsskemaet
                                for din Android-apps brugergrænseflade til
                                mørkere farver. Den er designet til at
                                reducere øjenbelastning, forbedre
                                tilgængelighed, spare batteristrøm og
                                forbedre brugeroplevelsen.
                            "</string>
    <string name="sound_effect">"Lydeffekt"</string>
    <string name="sound_effect_description">"
                                I Jetnote-appens kontekst giver funktionen
                                \'Lydeffekt\' auditiv feedback til brugere,
                                når de interagerer med knapper og andre
                                brugergrænsefladeelementer. Dette er
                                almindelig praksis i udvikling af mobilapps
                                for at gøre brugeroplevelsen mere
                                interaktiv og engagerende.
                            "</string>
    <string name="layouts">"Layouts"</string>
    <string name="layouts_description">"
                                Layouts er grundlæggende for at organisere
                                og vise indhold i dine Android-apps.
                                De definerer strukturen og arrangementet
                                af brugergrænsefladeelementer på skærmen.
                            "</string>
