    <string name="zen_mode">"Zen-tilstand"</string>
    <string name="zen_mode_description">"
                                Zen-tilstand (fuldskærm) er en
                                skærmindstilling, der giver en app mulighed
                                for at optage hele skærmen og skjule alle
                                andre grænsefladelementer såsom værktøjslinjer,
                                menuer og operativsystemets proceslinje.
                            "</string>
    <string name="shake">"Ryst for at rapportere"</string>
    <string name="shake_description">"
                              En praktisk funktion, der lader brugerne
                              starte en feedback- eller fejlrapporteringsproces
                              blot ved fysisk at ryste deres Android-enhed.
                              I stedet for at navigere gennem flere menuer
                              for at finde \'Send feedback\' eller
                              \'Rapporter en fejl\'.
                            "</string>
    <string name="block_screenshot">"Bloker skærmbillede"</string>
    <string name="block_screenshot_description">"
                                Blokering af skærmbilleder er en
                                sikkerhedsforanstaltning, der forhindrer
                                brugere i at tage skærmbilleder af din apps
                                indhold. Det bruges ofte til at beskytte
                                følsomme oplysninger, såsom bankoplysninger,
                                personlige data eller ophavsretligt
                                beskyttet materiale.
                            "</string>
    <string name="lock_mode">"Låsetilstand"</string>
    <string name="lock_mode_description">"
                                Denne funktion forbedrer sikkerheden i
                                din app ved at kræve, at brugerne
                                godkendes, før de kan få adgang til dens
                                indhold. Dette opnås typisk ved hjælp af
                                enhedens indbyggede sikkerhedsfunktioner,
                                såsom fingeraftryk, PIN eller
                                mønsteroplåsning.
                            "</string>
    <string name="licenses">"Licenser"</string>
    <string name="licenses_description">"
