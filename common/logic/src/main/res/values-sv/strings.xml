    <string name="account_sync">"Kontosynkronisering"</string>
    <string name="account_sync_description">"
                                Att aktivera Google Drive-kontosynkronisering
                                för den här appen låter dig sömlöst
                                säkerhetskopiera och synkronisera dina
                                appdata, som anteckningar och inställningar,
                                vilket säkerställer att dina data är säkra.
        "</string>
    <string name="assistant_configuration">"Assistentkonfiguration"</string>
    <string name="assistant_configuration_description">"
                                AI-assistenten är ett mjukvaruprogram
                                drivet av artificiell intelligens, utformat
                                för att hjälpa dig med ett brett spektrum
                                av uppgifter i den här appen.
                                Dessa assistenter förstår och svarar på
                                naturligt språk, vilket gör att du kan
                                interagera med dem via bild eller text.
                            "</string>
    <string name="dark_mode">"Mörkt läge"</string>
    <string name="dark_mode_description">"
                                Det här läget är en systemomfattande
                                inställning som ändrar bakgrundsschemat
                                för din Android-apps gränssnitt till
                                mörkare färger. Det är utformat för att
                                minska ögonbelastning, förbättra
                                tillgänglighet, spara batteri och
                                förbättra användarupplevelsen.
                            "</string>
    <string name="sound_effect">"Ljudeffekt"</string>
    <string name="sound_effect_description">"
                                I Jetnote-applikationens sammanhang
                                ger \'Ljudeffekt\'-funktionen auditiv
                                återkoppling till användare när de
                                interagerar med knappar och andra
                                gränssnittselement. Det här är en vanlig
                                praxis i mobilappsutveckling för att göra
                                användarupplevelsen mer interaktiv
                                och engagerande.
                            "</string>
    <string name="layouts">"Layouter"</string>
    <string name="layouts_description">"
                                Layouter är grundläggande för att
                                organisera och visa innehåll i dina
                                Android-appar. De definierar strukturen
                                och arrangemanget av gränssnittselement
                                på skärmen.
                            "</string>
