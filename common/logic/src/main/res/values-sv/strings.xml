    <string name="zen_mode">"Zen-läge"</string>
    <string name="zen_mode_description">"
                                Zen-läge (helskärmsläge) är en
                                visningsinställning som gör att en app
                                kan ta upp hela skärmen och dölja alla
                                andra gränssnittselement som verktygsfält,
                                menyer och operativsystemets aktivitetsfält.
                            "</string>
    <string name="shake">"Skaka för att rapportera"</string>
    <string name="shake_description">"
                              Det är en bekväm funktion som låter användare
                              starta en feedback- eller felrapporteringsprocess
                              bara genom att fysiskt skaka sin Android-enhet.
                              Istället för att navigera genom flera menyer
                              för att hitta \'Skicka feedback\'
                              eller \'Rapportera ett fel\'.
                            "</string>
    <string name="block_screenshot">"Blockera skärmdump"</string>
    <string name="block_screenshot_description">"
                                Skärmdumpsblockering är en säkerhetsåtgärd
                                som hindrar användare från att ta
                                skärmdumpar av appens innehåll.
                                Det används ofta för att skydda känslig
                                information, som bankuppgifter,
                                personuppgifter eller upphovsrättsskyddat
                                material.
                            "</string>
    <string name="lock_mode">"Låsläge"</string>
    <string name="lock_mode_description">"
                                Den här funktionen förbättrar appens
                                säkerhet genom att kräva att användare
                                autentiserar sig innan de kan komma åt
                                dess innehåll. Det uppnås vanligtvis med
                                enhetens inbyggda säkerhetsfunktioner,
                                som fingeravtryck, PIN-kod eller mönster.
                            "</string>
    <string name="licenses">"Licenser"</string>
    <string name="licenses_description">"
