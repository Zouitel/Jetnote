    <string name="account_sync">"Penyegerakan Akaun"</string>
    <string name="account_sync_description">"
                                Mengaktifkan penyegerakan akaun Google Drive
                                untuk aplikasi ini membolehkan anda
                                membuat sandaran dan menyegerakkan data
                                aplikasi, seperti nota dan tetapan,
                                dengan lancar, memastikan data anda selamat.
        "</string>
    <string name="assistant_configuration">"Konfigurasi Pembantu"</string>
    <string name="assistant_configuration_description">"
                                Pembantu AI ialah program perisian yang
                                dikuasakan oleh kecerdasan buatan,
                                direka untuk membantu anda dengan pelbagai
                                tugasan dalam aplikasi ini. Pembantu ini
                                memahami dan bertindak balas terhadap
                                bahasa semula jadi, membolehkan anda
                                berinteraksi melalui imej atau teks.
                            "</string>
    <string name="dark_mode">"Mod Gelap"</string>
    <string name="dark_mode_description">"
                                Mod ini ialah tetapan seluruh sistem yang
                                menukar skema latar belakang antara muka
                                aplikasi Android anda kepada warna yang
                                lebih gelap. Direka untuk mengurangkan
                                ketegangan mata, meningkatkan kebolehaksesan,
                                menjimatkan bateri dan meningkatkan
                                pengalaman pengguna.
                            "</string>
    <string name="sound_effect">"Kesan Bunyi"</string>
    <string name="sound_effect_description">"
                                Dalam konteks aplikasi Jetnote,
                                ciri \'Kesan Bunyi\' memberikan maklum
                                balas pendengaran kepada pengguna apabila
                                mereka berinteraksi dengan butang dan
                                elemen UI lain. Ini adalah amalan biasa
                                dalam pembangunan aplikasi mudah alih untuk
                                menjadikan pengalaman pengguna lebih
                                interaktif dan menarik.
                            "</string>
    <string name="layouts">"Susun Atur"</string>
    <string name="layouts_description">"
                                Susun atur adalah asas untuk mengatur
                                dan memaparkan kandungan dalam aplikasi
                                Android anda. Ia mentakrifkan struktur
                                dan susunan elemen UI pada skrin.
                            "</string>
    <string name="sort_notes">"Isih Nota"</string>
    <string name="default_sort">"lalai"</string>
    <string name="name_sort">"nama"</string>
    <string name="oldest_sort">"terlama"</string>
    <string name="newest_sort">"terbaru"</string>
    <string name="priority_sort">"keutamaan"</string>
    <string name="zen_mode">"Mod Zen"</string>
    <string name="zen_mode_description">"
                                Mod Zen (mod skrin penuh) ialah tetapan
                                paparan yang membolehkan aplikasi menempati
                                keseluruhan skrin, menyembunyikan semua
                                elemen antara muka lain seperti bar alat,
                                menu dan bar tugas sistem pengendalian.
                            "</string>
    <string name="shake">"Goncang untuk Lapor"</string>
    <string name="shake_description">"
                              Ini adalah ciri yang memudahkan pengguna
                              memulakan proses maklum balas atau pelaporan
                              pepijat hanya dengan menggoncang peranti
                              Android mereka secara fizikal. Daripada
                              menavigasi beberapa menu untuk mencari
                              \'Hantar Maklum Balas\' atau \'Lapor Pepijat\'.
                            "</string>
    <string name="block_screenshot">"Sekat Tangkapan Skrin"</string>
    <string name="block_screenshot_description">"
                                Penyekatan tangkapan skrin ialah langkah
                                keselamatan yang menghalang pengguna
                                daripada menangkap tangkapan skrin
                                kandungan aplikasi anda. Sering digunakan
                                untuk melindungi maklumat sensitif seperti
                                butiran perbankan, data peribadi atau
                                bahan yang dilindungi hak cipta.
                            "</string>
    <string name="lock_mode">"Mod Kunci"</string>
    <string name="lock_mode_description">"
                                Ciri ini meningkatkan keselamatan aplikasi
                                dengan memerlukan pengguna mengesahkan
                                identiti sebelum mengakses kandungan.
                                Biasanya dicapai menggunakan ciri keselamatan
                                terbina dalam peranti, seperti cap jari,
                                PIN atau pola buka kunci.
                            "</string>
    <string name="licenses">"Lesen"</string>
    <string name="licenses_description">"
                                    Lesen ini disertakan untuk mematuhi
                                    keperluan pengedaran penulis masing-masing
                                    dan memberikan ketelusan mengenai
                                    seni bina perisian.
                                    "</string>
