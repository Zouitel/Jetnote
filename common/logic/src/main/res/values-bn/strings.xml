    <string name="shake">"রিপোর্ট করতে ঝাঁকান"</string>
    <string name="shake_description">"
                              এটি একটি সুবিধাজনক ফিচার যা ব্যবহারকারীদের
                              শুধুমাত্র Android ডিভাইস শারীরিকভাবে
                              ঝাঁকিয়ে মতামত বা বাগ রিপোর্ট করার
                              প্রক্রিয়া শুরু করতে দেয়। \'ফিডব্যাক পাঠান\'
                              বা \'বাগ রিপোর্ট করুন\' খুঁজতে
                              একাধিক মেনু নেভিগেট না করে।
                            "</string>
    <string name="block_screenshot">"স্ক্রিনশট ব্লক করুন"</string>
    <string name="block_screenshot_description">"
                                স্ক্রিনশট ব্লকিং একটি নিরাপত্তা ব্যবস্থা
                                যা ব্যবহারকারীদের অ্যাপের বিষয়বস্তুর
                                স্ক্রিনশট নিতে বাধা দেয়। এটি প্রায়শই
                                ব্যাংকিং বিবরণ, ব্যক্তিগত ডেটা বা
                                কপিরাইট-সুরক্ষিত উপকরণের মতো
                                সংবেদনশীল তথ্য রক্ষা করতে ব্যবহৃত হয়।
                            "</string>
    <string name="lock_mode">"লক মোড"</string>
    <string name="lock_mode_description">"
                                এই ফিচারটি বিষয়বস্তু অ্যাক্সেস করার
                                আগে ব্যবহারকারীদের প্রমাণীকরণ
                                প্রয়োজন করে অ্যাপের নিরাপত্তা বাড়ায়।
                                এটি সাধারণত ফিঙ্গারপ্রিন্ট, পিন বা
                                প্যাটার্ন আনলকের মতো ডিভাইসের
                                বিল্ট-ইন নিরাপত্তা ফিচার ব্যবহার করে
                                অর্জন করা হয়।
                            "</string>
