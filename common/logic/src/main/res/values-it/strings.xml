    <string name="account_sync">"Sincronizzazione account"</string>
    <string name="account_sync_description">"
                                L\'abilitazione della sincronizzazione
                                con Google Drive per questa applicazione
                                consente di eseguire il backup e sincronizzare
                                i dati dell\'app, come note e impostazioni,
                                in modo semplice, garantendo la sicurezza
                                dei tuoi dati.
        "</string>
    <string name="assistant_configuration">"Configurazione assistente"</string>
    <string name="assistant_configuration_description">"
                                L\'assistente IA è un programma software
                                basato sull\'intelligenza artificiale,
                                progettato per aiutarti in un\'ampia gamma
                                di attività in questa applicazione.
                                Questi assistenti comprendono e rispondono
                                al linguaggio naturale, permettendoti di
                                interagire con loro tramite immagini o testo.
                            "</string>
    <string name="dark_mode">"Modalità scura"</string>
    <string name="dark_mode_description">"
                                Questa modalità è un\'impostazione di sistema
                                che modifica lo schema di sfondo
                                dell\'interfaccia dell\'app Android
                                con colori più scuri.
                                È progettata per ridurre l\'affaticamento
                                visivo, migliorare l\'accessibilità,
                                risparmiare la batteria e migliorare
                                l\'esperienza utente.
                            "</string>
    <string name="sound_effect">"Effetti sonori"</string>
    <string name="sound_effect_description">"
                                Nell\'applicazione Jetnote, la funzione
                                \'Effetti sonori\' fornisce un feedback
                                uditivo agli utenti quando interagiscono
                                con pulsanti e altri elementi dell\'interfaccia.
                                Questa è una pratica comune nello sviluppo
                                di app mobili per rendere l\'esperienza
                                utente più interattiva e coinvolgente.
                            "</string>
    <string name="layouts">"Layout"</string>
    <string name="layouts_description">"
                                I layout sono fondamentali per organizzare
                                e visualizzare i contenuti nelle app Android.
                                Definiscono la struttura e la disposizione
                                degli elementi dell\'interfaccia sullo schermo.
                            "</string>
    <string name="sort_notes">"Ordina note"</string>
    <string name="default_sort">"predefinito"</string>
    <string name="name_sort">"nome"</string>
    <string name="oldest_sort">"più vecchio"</string>
    <string name="newest_sort">"più recente"</string>
    <string name="priority_sort">"priorità"</string>
    <string name="zen_mode">"Modalità Zen"</string>
    <string name="zen_mode_description">"
                                La modalità Zen (schermo intero) è
                                un\'impostazione che consente all\'app di
                                occupare l\'intero schermo, nascondendo
                                tutti gli altri elementi dell\'interfaccia
                                come barre degli strumenti, menu e
                                la barra delle applicazioni del sistema.
                            "</string>
    <string name="shake">"Agita per segnalare"</string>
    <string name="shake_description">"
                              È una funzione pratica che consente agli utenti
                              di avviare un processo di feedback o segnalazione
                              bug semplicemente agitando fisicamente
                              il proprio dispositivo Android. Invece di
                              navigare tra più menu per trovare
                              \'Invia feedback\' o \'Segnala un bug\'.
                            "</string>
    <string name="block_screenshot">"Blocca screenshot"</string>
    <string name="block_screenshot_description">"
                                Il blocco degli screenshot è una misura
                                di sicurezza che impedisce agli utenti
                                di catturare schermate del contenuto
                                dell\'app. Viene spesso utilizzato per
                                proteggere informazioni sensibili, come
                                dati bancari, dati personali o
                                materiale protetto da copyright.
                            "</string>
    <string name="lock_mode">"Modalità blocco"</string>
    <string name="lock_mode_description">"
                                Questa funzione migliora la sicurezza
                                dell\'app richiedendo agli utenti di
                                autenticarsi prima di accedere ai contenuti.
                                Viene solitamente realizzata utilizzando
                                le funzioni di sicurezza integrate del
                                dispositivo, come impronta digitale,
                                PIN o sblocco con sequenza.
                            "</string>
    <string name="licenses">"Licenze"</string>
    <string name="licenses_description">"
                                    Queste licenze sono incluse per rispettare
                                    i requisiti di distribuzione dei rispettivi
                                    autori e per garantire trasparenza
                                    riguardo all\'architettura del software.
                                    "</string>
