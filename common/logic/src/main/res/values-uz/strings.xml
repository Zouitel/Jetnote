    <string name="account_sync">"Hisob sinxronizatsiyasi"</string>
    <string name="account_sync_description">"
                                Ushbu ilova uchun Google Drive hisob
                                sinxronizatsiyasini yoqish ilova
                                ma\'lumotlarini, masalan, eslatmalar va
                                sozlamalarni muammosiz zaxiralash va
                                sinxronlash imkonini beradi, bu esa
                                ma\'lumotlaringiz xavfsizligini ta\'minlaydi.
        "</string>
    <string name="assistant_configuration">"Yordamchi konfiguratsiyasi"</string>
    <string name="assistant_configuration_description">"
                                AI yordamchi - bu ushbu ilovadagi
                                keng ko\'lamli vazifalarni bajarishda
                                yordam berish uchun mo\'ljallangan sun\'iy
                                intellekt bilan ishlaydigan dastur.
                                Bu yordamchilar tabiiy tilni tushunadi
                                va unga javob beradi, bu esa siz bilan
                                rasm yoki matn orqali muloqot qilish
                                imkonini beradi.
                            "</string>
    <string name="dark_mode">"Qorong\'u rejim"</string>
    <string name="dark_mode_description">"
                                Bu rejim Android ilovasining UI orqa
                                fon rangini quyuqroq ranglarga o\'zgartiruvchi
                                tizim miqyosidagi sozlamadir. U ko\'z
                                charchashini kamaytirish, kirish imkoniyatini
                                yaxshilash, batareya quvvatini tejash va
                                foydalanuvchi tajribasini yaxshilash uchun
                                mo\'ljallangan.
                            "</string>
    <string name="sound_effect">"Tovush effekti"</string>
    <string name="sound_effect_description">"
                                Jetnote ilovasi kontekstida tovush effekti
                                xususiyati foydalanuvchilarga tugmalar va
                                boshqa UI elementlari bilan o\'zaro
                                ta\'sirlashganda eshitish orqali fikr-
                                mulohaza beradi. Bu mobil ilova ishlab
                                chiqishda foydalanuvchi tajribasini yanada
                                interaktiv va qiziqarli qilish uchun
                                keng tarqalgan amaliyotdir.
                            "</string>
    <string name="layouts">"Tartiblar"</string>
    <string name="layouts_description">"
                                Tartiblar Android ilovalaringizda kontentni
                                tartibga solish va ko\'rsatish uchun asosiy
                                hisoblanadi. Ular ekrandagi UI elementlarining
                                tuzilishi va joylashuvini belgilaydi.
                            "</string>
