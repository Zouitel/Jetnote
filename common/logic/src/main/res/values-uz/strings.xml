    <string name="zen_mode">"Zen rejimi"</string>
    <string name="zen_mode_description">"
                                Zen rejimi (to\'liq ekran rejimi) ilovaga
                                butun ekranni egallash imkonini beruvchi
                                va asboblar panellari, menyular va
                                operatsion tizimning vazifalar paneli kabi
                                barcha boshqa interfeys elementlarini
                                yashiruvchi ko\'rsatish sozlamasidir.
                            "</string>
    <string name="shake">"Xabar berish uchun silkiting"</string>
    <string name="shake_description">"
                              Bu foydalanuvchilarga bir nechta menyular
                              orqali navigatsiya qilmasdan, Android
                              qurilmasini jismoniy silkitish orqali
                              fikr-mulohaza yoki xato haqida xabar
                              berish jarayonini boshlash imkonini
                              beruvchi qulay xususiyatdir.
                            "</string>
    <string name="block_screenshot">"Skrinshot bloklash"</string>
    <string name="block_screenshot_description">"
                                Skrinshotni bloklash - foydalanuvchilarga
                                ilovangiz kontentining skrinshotlarini
                                olishni oldini oluvchi xavfsizlik chorasidir.
                                Bu ko\'pincha bank ma\'lumotlari, shaxsiy
                                ma\'lumotlar yoki mualliflik huquqi bilan
                                himoyalangan materiallar kabi maxfiy
                                ma\'lumotlarni himoya qilish uchun ishlatiladi.
                            "</string>
    <string name="lock_mode">"Qulflash rejimi"</string>
    <string name="lock_mode_description">"
                                Ushbu xususiyat foydalanuvchilardan
                                kontentga kirishdan oldin autentifikatsiya
                                talab qilish orqali ilovangiz xavfsizligini
                                kuchaytiradi. Bu odatda barmoq izi, PIN
                                yoki naqsh qulfini ochish kabi qurilmaning
                                o\'rnatilgan xavfsizlik xususiyatlaridan
                                foydalanib amalga oshiriladi.
                            "</string>
    <string name="licenses">"Litsenziyalar"</string>
    <string name="licenses_description">"
                                    Ushbu litsenziyalar tegishli mualliflarning
                                    tarqatish talablariga rioya qilish va
                                    dasturiy ta\'minotning arxitekturasi
                                    haqida shaffoflikni ta\'minlash uchun
                                    shu yerga kiritilgan.
                                    "</string>
