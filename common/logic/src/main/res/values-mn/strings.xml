    <string name="account_sync">"Бүртгэл синхрончлол"</string>
    <string name="account_sync_description">"
                                Энэ аппликейшнд Google Drive бүртгэлийн
                                синхрончлолыг идэвхжүүлснээр тэмдэглэл,
                                тохиргоо зэрэг аппын өгөгдлийг
                                тасралтгүй нөөцлөх, синхрончлох боломжтой
                                болно, өгөгдлийн аюулгүй байдлыг хангана.
        "</string>
    <string name="assistant_configuration">"Туслагчийн тохиргоо"</string>
    <string name="assistant_configuration_description">"
                                AI туслагч нь хиймэл оюун ухаанаар
                                ажилладаг программ хангамж бөгөөд энэ
                                аппликейшнд олон төрлийн ажлыг гүйцэтгэхэд
                                тусалдаг. Эдгээр туслагчид байгалийн хэлийг
                                ойлгож хариулдаг бөгөөд зураг эсвэл текстээр
                                дамжуулан харилцах боломжтой.
                            "</string>
    <string name="dark_mode">"Харанхуй горим"</string>
    <string name="dark_mode_description">"
                                Энэ горим нь системийн нийтлэг тохиргоо
                                бөгөөд Android аппын хэрэглэгчийн интерфейсийн
                                арын дэвсгэрийг харанхуй өнгө рүү шилжүүлдэг.
                                Нүдний ядаргааг бууруулах, хүртээмжийг
                                нэмэгдүүлэх, батарей хэмнэх, хэрэглэгчийн
                                туршлагыг сайжруулах зорилготой.
                            "</string>
    <string name="sound_effect">"Дуу чимээний эффект"</string>
    <string name="sound_effect_description">"
                                Jetnote аппликейшний хүрээнд \'Дуу чимээний
                                эффект\' функц нь хэрэглэгчид товчлуур болон
                                бусад интерфейсийн элементүүдтэй харилцах үед
                                дуут санал хүсэлт өгдөг. Энэ нь мобайл
                                аппликейшн хөгжүүлэлтийн нийтлэг практик
                                бөгөөд хэрэглэгчийн туршлагыг илүү
                                интерактив болгодог.
                            "</string>
    <string name="layouts">"Загварууд"</string>
    <string name="layouts_description">"
                                Загварууд нь Android аппликейшнд агуулгыг
                                зохион байгуулж харуулахад үндсэн үүрэг
                                гүйцэтгэдэг. Дэлгэц дээрх интерфейсийн
                                элементүүдийн бүтэц, байршлыг тодорхойлдог.
                            "</string>
