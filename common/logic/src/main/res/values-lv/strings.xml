    <string name="account_sync">"Konta sinhronizācija"</string>
    <string name="account_sync_description">"
                                Iespējojot Google Drive konta
                                sinhronizāciju šai lietotnei, varat
                                nemanāmi dublēt un sinhronizēt
                                lietotnes datus, piemēram, piezīmes
                                un iestatījumus, nodrošinot datu
                                drošību.
        "</string>
    <string name="assistant_configuration">"Asistenta konfigurācija"</string>
    <string name="assistant_configuration_description">"
                                AI asistents ir mākslīgā intelekta
                                darbināta programmatūra, kas paredzēta,
                                lai palīdzētu jums ar plašu uzdevumu
                                klāstu šajā lietotnē.
                                Šie asistenti saprot dabisko valodu un
                                atbild uz to, ļaujot jums sazināties
                                ar tiem, izmantojot attēlu vai tekstu.
                            "</string>
    <string name="dark_mode">"Tumšais režīms"</string>
    <string name="dark_mode_description">"
                                Šis režīms ir sistēmas mēroga iestatījums,
                                kas maina jūsu Android lietotnes
                                saskarnē fona krāsu shēmu uz tumšākām
                                krāsām. Tas ir izstrādāts, lai mazinātu
                                acu nogurumu, uzlabotu pieejamību,
                                taupītu akumulatoru un uzlabotu
                                lietotāja pieredzi.
                            "</string>
    <string name="sound_effect">"Skaņas efekts"</string>
    <string name="sound_effect_description">"
                                Jetnote lietotnes kontekstā \'Skaņas
                                efekta\' funkcija sniedz skaņas
                                atgriezenisko saiti lietotājiem, kad
                                tie mijiedarbojas ar pogām un citiem
                                saskarnes elementiem. Tā ir izplatīta
                                prakse mobilo lietotņu izstrādē, lai
                                padarītu lietotāja pieredzi
                                interaktīvāku un saistošāku.
                            "</string>
    <string name="layouts">"Izkārtojumi"</string>
    <string name="layouts_description">"
                                Izkārtojumi ir būtiski satura
                                organizēšanai un attēlošanai Android
                                lietotnēs. Tie nosaka saskarnes
                                elementu struktūru un izvietojumu
                                ekrānā.
                            "</string>
