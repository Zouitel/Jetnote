    <string name="zen_mode">"Zen režīms"</string>
    <string name="zen_mode_description">"
                                Zen režīms (pilnekrāna režīms) ir
                                displeja iestatījums, kas ļauj lietotnei
                                aizņemt visu ekrānu, paslēpjot visus
                                citus saskarnes elementus, piemēram,
                                rīkjoslas, izvēlnes un OS uzdevumjoslu.
                            "</string>
    <string name="shake">"Sakratīt, lai ziņotu"</string>
    <string name="shake_description">"
                              Ērta funkcija, kas ļauj lietotājiem
                              uzsākt atsauksmju vai kļūdu ziņošanas
                              procesu, vienkārši fiziski sakratot
                              savu Android ierīci. Tā vietā, lai
                              pārvietotos cauri vairākām izvēlnēm,
                              meklējot \'Nosūtīt atsauksmes\' vai
                              \'Ziņot par kļūdu\'.
                            "</string>
    <string name="block_screenshot">"Bloķēt ekrānuzņēmumu"</string>
    <string name="block_screenshot_description">"
                                Ekrānuzņēmumu bloķēšana ir drošības
                                pasākums, kas neļauj lietotājiem
                                uzņemt jūsu lietotnes satura
                                ekrānuzņēmumus. To bieži izmanto,
                                lai aizsargātu sensitīvu informāciju,
                                piemēram, bankas datus, personas datus
                                vai ar autortiesībām aizsargātus
                                materiālus.
                            "</string>
    <string name="lock_mode">"Bloķēšanas režīms"</string>
    <string name="lock_mode_description">"
                                Šī funkcija uzlabo lietotnes drošību,
                                pieprasot lietotājiem autentifikāciju
                                pirms piekļuves saturam. To parasti
                                panāk, izmantojot ierīces iebūvētās
                                drošības funkcijas, piemēram,
                                pirksta nospiedumu, PIN vai
                                atbloķēšanas rakstu.
                            "</string>
    <string name="licenses">"Licences"</string>
