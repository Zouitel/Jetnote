    <string name="account_sync">"Sinkronisasi Akun"</string>
    <string name="account_sync_description">"
                                Mengaktifkan sinkronisasi akun Google Drive
                                untuk aplikasi ini memungkinkan Anda
                                mencadangkan dan menyinkronkan data
                                aplikasi, seperti catatan dan pengaturan,
                                dengan lancar, memastikan data Anda aman.
        "</string>
    <string name="assistant_configuration">"Konfigurasi Asisten"</string>
    <string name="assistant_configuration_description">"
                                Asisten AI adalah program perangkat lunak
                                yang didukung kecerdasan buatan, dirancang
                                untuk membantu Anda dengan berbagai tugas
                                di aplikasi ini. Asisten ini memahami dan
                                merespons bahasa alami, memungkinkan Anda
                                berinteraksi melalui gambar atau teks.
                            "</string>
    <string name="dark_mode">"Mode Gelap"</string>
    <string name="dark_mode_description">"
                                Mode ini adalah pengaturan seluruh sistem
                                yang mengubah skema latar belakang antarmuka
                                aplikasi Android Anda ke warna yang lebih gelap.
                                Dirancang untuk mengurangi ketegangan mata,
                                meningkatkan aksesibilitas, menghemat baterai,
                                dan meningkatkan pengalaman pengguna.
                            "</string>
    <string name="sound_effect">"Efek Suara"</string>
    <string name="sound_effect_description">"
                                Dalam konteks aplikasi Jetnote, fitur
                                \'Efek Suara\' memberikan umpan balik
                                pendengaran kepada pengguna saat mereka
                                berinteraksi dengan tombol dan elemen UI
                                lainnya. Ini adalah praktik umum dalam
                                pengembangan aplikasi mobile untuk membuat
                                pengalaman pengguna lebih interaktif dan
                                menarik.
                            "</string>
    <string name="layouts">"Tata Letak"</string>
    <string name="layouts_description">"
                                Tata letak sangat penting untuk mengatur
                                dan menampilkan konten di aplikasi Android.
                                Tata letak mendefinisikan struktur dan
                                susunan elemen UI di layar.
                            "</string>
    <string name="sort_notes">"Urutkan Catatan"</string>
    <string name="default_sort">"bawaan"</string>
    <string name="name_sort">"nama"</string>
    <string name="oldest_sort">"terlama"</string>
    <string name="newest_sort">"terbaru"</string>
    <string name="priority_sort">"prioritas"</string>
    <string name="zen_mode">"Mode Zen"</string>
    <string name="zen_mode_description">"
                                Mode Zen (mode layar penuh) adalah
                                pengaturan tampilan yang memungkinkan
                                aplikasi menempati seluruh layar,
                                menyembunyikan semua elemen antarmuka
                                lainnya seperti bilah alat, menu, dan
                                bilah tugas sistem operasi.
                            "</string>
    <string name="shake">"Kocok untuk Melapor"</string>
    <string name="shake_description">"
                              Ini adalah fitur yang memudahkan pengguna
                              memulai proses umpan balik atau pelaporan
                              bug hanya dengan menggoyangkan perangkat
                              Android mereka secara fisik. Daripada
                              menavigasi beberapa menu untuk menemukan
                              \'Kirim Masukan\' atau \'Laporkan Bug\'.
                            "</string>
    <string name="block_screenshot">"Blokir Tangkapan Layar"</string>
    <string name="block_screenshot_description">"
                                Pemblokiran tangkapan layar adalah langkah
                                keamanan yang mencegah pengguna mengambil
                                tangkapan layar konten aplikasi Anda.
                                Sering digunakan untuk melindungi informasi
                                sensitif, seperti detail perbankan, data
                                pribadi, atau materi yang dilindungi hak cipta.
                            "</string>
    <string name="lock_mode">"Mode Kunci"</string>
    <string name="lock_mode_description">"
                                Fitur ini meningkatkan keamanan aplikasi
                                dengan mengharuskan pengguna melakukan
                                autentikasi sebelum mengakses konten.
                                Biasanya dicapai menggunakan fitur keamanan
                                bawaan perangkat, seperti sidik jari,
                                PIN, atau pola buka kunci.
                            "</string>
    <string name="licenses">"Lisensi"</string>
    <string name="licenses_description">"
                                    Lisensi ini disertakan untuk mematuhi
                                    persyaratan distribusi penulis masing-masing
                                    dan memberikan transparansi mengenai
                                    arsitektur perangkat lunak.
                                    "</string>
