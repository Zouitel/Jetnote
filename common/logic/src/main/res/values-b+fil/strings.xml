    <string name="zen_mode">"Zen Mode"</string>
    <string name="zen_mode_description">"
                                Ang Zen mode (full screen mode) ay isang
                                display setting na nagpapahintulot sa isang
                                application na sakupin ang buong screen,
                                itinatago ang lahat ng iba pang mga elemento
                                ng interface tulad ng mga toolbar, menu, at
                                taskbar ng operating system.
                            "</string>
    <string name="shake">"I-shake para Mag-ulat"</string>
    <string name="shake_description">"
                              Ito ay isang maginhawang feature na nagbibigay-
                              daan sa mga gumagamit na simulan ang proseso
                              ng feedback o pag-uulat ng bug sa pamamagitan
                              ng pisikal na pag-shake ng kanilang Android device.
                              Sa halip na mag-navigate sa maraming menu
                              upang mahanap ang \'Magpadala ng Feedback\'
                              o \'Mag-ulat ng Bug\'.
                            "</string>
    <string name="block_screenshot">"I-block ang Screenshot"</string>
    <string name="block_screenshot_description">"
                                Ang pag-block ng screenshot ay isang
                                hakbang sa seguridad na pumipigil sa mga
                                gumagamit na kumuha ng screenshot ng nilalaman
                                ng iyong app. Madalas na ginagamit upang
                                protektahan ang sensitibong impormasyon,
                                tulad ng mga detalye ng banking, personal
                                na data, o materyal na protektado ng copyright.
                            "</string>
    <string name="lock_mode">"Lock Mode"</string>
    <string name="lock_mode_description">"
                                Ang feature na ito ay nagpapahusay ng
                                seguridad ng iyong app sa pamamagitan ng
                                pag-aatas sa mga gumagamit na mag-authenticate
                                bago ma-access ang nilalaman. Karaniwang
                                natatamo ito gamit ang mga built-in na
                                feature ng seguridad ng device, tulad ng
                                fingerprint, PIN, o pattern unlock.
                            "</string>
    <string name="licenses">"Mga Lisensya"</string>
    <string name="licenses_description">"
                                    Ang mga lisensyang ito ay kasama dito
                                    upang sumunod sa mga kinakailangan sa
                                    pamamahagi ng kani-kanilang mga may-akda
                                    at upang magbigay ng transparency tungkol
                                    sa arkitektura ng software.
                                    "</string>
