    <string name="account_sync">"Pag-sync ng Account"</string>
    <string name="account_sync_description">"
                                Ang pag-enable ng Google Drive account sync
                                para sa app na ito ay nagbibigay-daan sa iyong
                                i-backup at i-sync nang maayos ang data ng app,
                                tulad ng mga tala at setting, upang matiyak
                                na ligtas ang iyong data.
        "</string>
    <string name="assistant_configuration">"Konfigurasyong ng Assistant"</string>
    <string name="assistant_configuration_description">"
                                Ang AI assistant ay isang software program
                                na pinapagana ng artificial intelligence,
                                na dinisenyo upang tulungan ka sa malawak
                                na hanay ng mga gawain sa app na ito.
                                Naiintindihan at tumutugon ang mga assistant
                                sa natural na wika, na nagbibigay-daan sa iyong
                                makipag-ugnayan sa kanila sa pamamagitan
                                ng larawan o teksto.
                            "</string>
    <string name="dark_mode">"Dark Mode"</string>
    <string name="dark_mode_description">"
                                Ang mode na ito ay isang setting na
                                pang-buong sistema na nagbabago ng
                                background color scheme ng UI ng iyong
                                Android app sa mas madilim na mga kulay.
                                Dinisenyo upang bawasan ang pagkapagod
                                ng mata, mapabuti ang accessibility,
                                makatipid ng baterya, at mapahusay ang
                                karanasan ng gumagamit.
                            "</string>
    <string name="sound_effect">"Sound Effect"</string>
    <string name="sound_effect_description">"
                                Sa konteksto ng Jetnote app, ang feature
                                na \'Sound Effect\' ay nagbibigay ng
                                auditory feedback sa mga gumagamit kapag
                                nakikipag-ugnayan sila sa mga button at
                                iba pang mga elemento ng UI.
                                Ito ay karaniwang gawi sa pagbuo ng
                                mobile app upang gawing mas interactive
                                at nakakaengganyo ang karanasan ng gumagamit.
                            "</string>
    <string name="layouts">"Mga Layout"</string>
    <string name="layouts_description">"
                                Ang mga layout ay pangunahin sa pag-oorganisa
                                at pagpapakita ng nilalaman sa iyong mga
                                Android app. Tinutukoy nila ang istraktura
                                at kaayusan ng mga elemento ng UI sa screen.
                            "</string>
    <string name="sort_notes">"Ayusin ang mga Tala"</string>
