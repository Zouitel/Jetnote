    <string name="account_sync_description">"
                                Įjungus Google Drive paskyros
                                sinchronizaciją šioje programėlėje,
                                galėsite sklandžiai kurti atsargines
                                kopijas ir sinchronizuoti programėlės
                                duomenis, pvz., užrašus ir nustatymus,
                                užtikrinant duomenų saugumą.
        "</string>
    <string name="assistant_configuration">"Asistento konfigūracija"</string>
    <string name="assistant_configuration_description">"
                                AI asistentas yra dirbtinio intelekto
                                valdoma programinė įranga, sukurta
                                padėti jums atlikti įvairias užduotis
                                šioje programėlėje.
                                Šie asistentai supranta ir atsako į
                                natūralią kalbą, leidžiant jums su
                                jais bendrauti per vaizdą ar tekstą.
                            "</string>
    <string name="dark_mode">"Tamsus režimas"</string>
    <string name="dark_mode_description">"
                                Šis režimas yra visos sistemos nustatymas,
                                kuris pakeičia jūsų Android programėlės
                                vartotojo sąsajos fono spalvų schemą į
                                tamsesnes spalvas. Jis skirtas mažinti
                                akių nuovargį, pagerinti prieinamumą,
                                taupyti bateriją ir pagerinti
                                vartotojo patirtį.
                            "</string>
    <string name="sound_effect">"Garso efektas"</string>
    <string name="sound_effect_description">"
                                Jetnote programėlės kontekste \'Garso
                                efekto\' funkcija teikia garsinį
                                grįžtamąjį ryšį vartotojams, kai jie
                                sąveikauja su mygtukais ir kitais
                                sąsajos elementais. Tai įprasta
                                mobiliųjų programėlių kūrimo praktika,
                                siekiant padaryti vartotojo patirtį
                                interaktyvesnę ir patrauklesnę.
                            "</string>
    <string name="layouts">"Išdėstymai"</string>
    <string name="layouts_description">"
                                Išdėstymai yra pagrindiniai turiniui
                                organizuoti ir rodyti Android
                                programėlėse. Jie apibrėžia sąsajos
                                elementų struktūrą ir išdėstymą
                                ekrane.
                            "</string>
