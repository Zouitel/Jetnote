    <string name="zen_mode">"Zen režimas"</string>
    <string name="zen_mode_description">"
                                Zen režimas (viso ekrano režimas) yra
                                ekrano nustatymas, leidžiantis programėlei
                                užimti visą ekraną, paslėpiant visus
                                kitus sąsajos elementus, pvz.,
                                įrankių juostas, meniu ir OS užduočių
                                juostą.
                            "</string>
    <string name="shake">"Papurtyti, kad praneštumėte"</string>
    <string name="shake_description">"
                              Patogi funkcija, leidžianti vartotojams
                              inicijuoti atsiliepimų ar klaidų
                              pranešimo procesą tiesiog fiziškai
                              papurčius Android įrenginį. Vietoj to,
                              kad naršytumėte per kelis meniu ieškodami
                              \'Siųsti atsiliepimą\' arba
                              \'Pranešti apie klaidą\'.
                            "</string>
    <string name="block_screenshot">"Blokuoti ekrano kopiją"</string>
    <string name="block_screenshot_description">"
                                Ekrano kopijų blokavimas yra saugumo
                                priemonė, neleidžianti vartotojams
                                daryti jūsų programėlės turinio ekrano
                                kopijų. Dažnai naudojama siekiant
                                apsaugoti jautrią informaciją, pvz.,
                                bankininkystės duomenis, asmeninius
                                duomenis ar autorių teisėmis saugomą
                                medžiagą.
                            "</string>
    <string name="lock_mode">"Užrakinimo režimas"</string>
    <string name="lock_mode_description">"
                                Ši funkcija pagerina jūsų programėlės
                                saugumą, reikalaujant vartotojų
                                autentifikuotis prieš pasiekiant turinį.
                                Tai paprastai pasiekiama naudojant
                                įrenginio integruotas saugumo funkcijas,
                                pvz., pirštų atspaudą, PIN kodą arba
                                atrakinimo šabloną.
                            "</string>
