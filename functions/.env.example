# Comma-separated SiliconFlow model IDs allowed for Jetnote's managed/free tier.
# This is enforced by the backend; Remote Config is only a client-side display hint.
AI_PROXY_ALLOWED_MODELS=replace-with-your-free-model-ids

# Per-Firebase-UID quotas. Requests are counted before they reach SiliconFlow.
AI_RATE_LIMIT_PER_MINUTE=20
AI_RATE_LIMIT_PER_DAY=300
